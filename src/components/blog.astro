---
import Layout from '../layouts/Layout.astro';
import { BLOG_POSTS } from '../lib/defaults';

interface Props {
  posts?: any[];
  categories?: any[];
  pageData?: any;
  seo?: any;
}

const { posts = [], categories = [], pageData, seo } = Astro.props;

// Editable hero + newsletter copy (WP Blog page), with the original text as fallback.
const heroBadge = pageData?.heroBadge || 'B2B RESOURCE HUB';
const heroTitle = pageData?.heroTitle || 'Product Guides & Custom Manufacturing Insights';
const heroSubtitle = pageData?.heroSubtitle || 'Expert advice on materials, manufacturing techniques, and design best-practices for high-performance industrial branding.';
const heroImage = pageData?.heroImage?.node?.sourceUrl || '';
const newsletterTitle = pageData?.newsletterTitle || 'Industrial Insights to Your Inbox';
const newsletterText = pageData?.newsletterText || 'Get bi-weekly updates on manufacturing trends, material sciences, and cost-saving procurement strategies for your branding needs.';
const newsletterButton = pageData?.newsletterButton || 'Subscribe to Insights';

const activePosts = posts.length > 0 ? posts : BLOG_POSTS;

// Category filter buttons: dynamic from WP, fall back to those present on posts.
const presentMap = new Map<string, string>();
activePosts.forEach((p: any) => (p?.categories?.nodes || []).forEach((c: any) => {
  if (c?.slug) presentMap.set(c.slug, c.name || c.slug);
}));
const filterCats = (categories && categories.length > 0)
  ? categories
  : [...presentMap].map(([slug, name]) => ({ slug, name }));

const formatDate = (dateStr: string) => {
  try {
    const d = new Date(dateStr);
    return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }).toUpperCase();
  } catch { return ''; }
};

const stripHtml = (html: string) => {
  if (!html) return '';
  return html.replace(/<[^>]*>/g, '').trim();
};

// Data attributes used by the client-side filter/search.
const catSlugs = (p: any) => (p?.categories?.nodes || []).map((c: any) => c.slug).join(' ');
const searchData = (p: any) => `${p?.title || ''} ${stripHtml(p?.excerpt || '')}`.toLowerCase();
---

<Layout title="Blog | Hong Yu Manufacturing Insights" seo={seo}>
    <main class="max-w-full">
        <!-- Hero Section -->
        <section class="relative bg-primary py-xl flex items-center min-h-[260px] md:min-h-[504px] overflow-hidden">
            {heroImage && (
                <div class="absolute inset-0 pointer-events-none">
                    <img alt={heroTitle} fetchpriority="high" decoding="async" class="w-full h-full object-cover opacity-90" src={heroImage} />
                    <div class="absolute inset-0 bg-gradient-to-r from-primary via-primary/85 to-primary/40"></div>
                </div>
            )}
            <div class="relative z-10 max-w-container-max mx-auto px-gutter w-full">
                <div class="max-w-3xl">
                    {heroBadge && (
                        <div class="flex items-center gap-sm mb-sm">
                            <span class="font-label-bold text-label-bold text-cta-orange uppercase tracking-[0.2em] text-[12px]">{heroBadge}</span>
                        </div>
                    )}
                    <h1 class="font-display-lg text-white mb-md text-[22px] sm:text-[30px] lg:text-[44px] leading-[1.15] tracking-tight">{heroTitle}</h1>
                    <p class="font-body-lg text-body-lg text-white/80">{heroSubtitle}</p>
                </div>
            </div>
        </section>
        <!-- Category Filter + Search -->
        <section class="bg-white border-b border-outline-variant sticky top-[68px] z-40">
            <div class="max-w-container-max mx-auto px-gutter py-md flex flex-col lg:flex-row lg:items-center gap-md lg:justify-between">
                <div class="flex items-center gap-md overflow-x-auto hide-scrollbar">
                    <span class="font-label-bold text-on-surface whitespace-nowrap hidden sm:inline">CATEGORIES:</span>
                    <div class="flex gap-sm" id="blog-filters">
                        <button data-filter="all"
                            class="blog-filter-btn px-5 py-2 rounded-full border border-primary bg-primary text-on-primary font-label-md transition-all whitespace-nowrap">All Posts</button>
                        {filterCats.map((c: any) => (
                            <button data-filter={c.slug}
                                class="blog-filter-btn px-5 py-2 rounded-full border border-outline-variant hover:border-primary text-on-surface-variant font-label-md transition-all whitespace-nowrap">{c.name}</button>
                        ))}
                    </div>
                </div>
                <div class="relative w-full lg:w-72 shrink-0">
                    <span class="material-symbols-outlined absolute left-3.5 top-1/2 -translate-y-1/2 text-outline text-[20px] pointer-events-none">search</span>
                    <input id="blog-search" type="text" placeholder="Search insights..."
                        class="w-full pl-11 pr-4 py-2.5 rounded-full border border-outline-variant bg-surface-container-low text-body-sm text-on-surface placeholder:text-outline focus:bg-white focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none transition-all" />
                </div>
            </div>
        </section>
        <!-- Article Grid (all posts, 12 per page with pagination) -->
        <section class="max-w-container-max mx-auto px-gutter py-xl">
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-md" id="blog-grid">
                {activePosts.map((post: any) => (
                    <a href={`/blog/${post.slug}`}
                        data-cats={catSlugs(post)}
                        data-search={searchData(post)}
                        class="blog-card card-lift bg-white border border-outline-variant rounded-lg overflow-hidden flex flex-col hover:border-primary group shadow-sm">
                        <div class="aspect-square overflow-hidden">
                            {post.featuredImage?.node?.sourceUrl ? (
                                <img alt={post.title} loading="lazy" decoding="async"
                                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                                    src={post.featuredImage.node.sourceUrl} />
                            ) : (
                                <div class="w-full h-full flex items-center justify-center bg-surface-container-low text-outline">
                                    <span class="material-symbols-outlined text-5xl">image</span>
                                </div>
                            )}
                        </div>
                        <div class="p-md flex flex-col flex-grow">
                            <div class="flex items-center gap-base mb-sm">
                                {post.categories?.nodes?.[0] && (
                                    <span
                                        class="bg-secondary-container text-on-secondary-container px-2 py-0.5 rounded text-[10px] font-label-bold uppercase">{post.categories.nodes[0].name}</span>
                                )}
                                <span class="text-outline text-[12px]">{formatDate(post.date)}</span>
                            </div>
                            <h3
                                class="font-headline-sm text-headline-sm text-primary group-hover:text-secondary transition-colors line-clamp-2">
                                {post.title}</h3>
                            <div class="mt-auto pt-md">
                                <span class="text-primary font-label-bold text-[12px] inline-flex items-center gap-1.5 group/btn">
                                    Read More
                                    <span class="material-symbols-outlined text-[16px] transition-transform group-hover/btn:translate-x-1">arrow_forward</span>
                                </span>
                            </div>
                        </div>
                    </a>
                ))}
            </div>
            <div id="blog-empty" class="hidden text-center py-xl text-outline font-body-md">No articles match your search.</div>
            <nav id="blog-pagination" class="hidden flex flex-wrap items-center justify-center gap-xs pt-xl" aria-label="Blog pagination"></nav>
        </section>
        <!-- Newsletter CTA -->
        <section class="max-w-container-max mx-auto px-gutter pb-xl">
            <div
                class="bg-primary text-on-primary rounded-2xl p-xl flex flex-col lg:flex-row items-center gap-xl relative overflow-hidden">
                <div
                    class="absolute right-[-50px] top-[-50px] w-64 h-64 opacity-10 pointer-events-none bg-white rounded-full">
                </div>
                <div class="flex-1 relative z-10 text-center lg:text-left">
                    <h2 class="font-headline-lg text-headline-lg mb-base leading-tight">{newsletterTitle}</h2>
                    <p class="text-primary-fixed font-body-md max-w-xl">{newsletterText}</p>
                </div>
                <div class="w-full lg:w-1/3 relative z-10">
                    <form class="flex flex-col gap-base" action="/api/newsletter" method="POST" data-ajax-form data-success="You're subscribed! Watch your inbox for our next industrial insights update.">
                        <input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" autocomplete="off" />
                        <div class="relative">
                            <input name="email" required aria-label="Work email address"
                                class="w-full bg-white border-0 rounded-lg px-5 py-4 text-on-background focus:ring-2 focus:ring-secondary outline-none transition-all"
                                placeholder="Enter your work email" type="email" />
                        </div>
                        <button
                            class="bg-[#E67E22] text-white px-8 py-4 rounded-lg font-label-bold hover:brightness-110 transition-all shadow-lg active:scale-95 disabled:opacity-60 disabled:cursor-not-allowed"
                            type="submit">{newsletterButton}</button>
                        <p data-form-status role="status" aria-live="polite" class="text-[13px] text-white text-center min-h-[1rem]"></p>
                        <p class="text-[12px] text-primary-fixed/70 text-center">Strict B2B only. No spam.</p>
                    </form>
                </div>
            </div>
        </section>
    </main>
</Layout>

<script>
    import { initForms } from '../lib/forms';

    // 12 posts per page (all breakpoints).
    const perPage = () => 12;

    // Page-number list with ellipsis: 1 … 4 5 [6] 7 8 … 20
    const pageList = (current: number, total: number): (number | string)[] => {
        if (total <= 7) return Array.from({ length: total }, (_, i) => i + 1);
        const out: (number | string)[] = [1];
        const start = Math.max(2, current - 1);
        const end = Math.min(total - 1, current + 1);
        if (start > 2) out.push('…');
        for (let i = start; i <= end; i++) out.push(i);
        if (end < total - 1) out.push('…');
        out.push(total);
        return out;
    };

    const setupBlog = () => {
        const filterWrap = document.getElementById('blog-filters');
        const grid = document.getElementById('blog-grid');
        const empty = document.getElementById('blog-empty');
        const pager = document.getElementById('blog-pagination');
        const search = document.getElementById('blog-search') as HTMLInputElement | null;
        if (!filterWrap || !grid || !pager) return;
        const buttons = Array.from(filterWrap.querySelectorAll('.blog-filter-btn')) as HTMLElement[];
        const cards = Array.from(grid.querySelectorAll('.blog-card')) as HTMLElement[];

        let filter = 'all';
        let term = '';
        let page = 1;

        const isDefault = () => filter === 'all' && term === '';

        const matches = (card: HTMLElement) => {
            const cats = (card.getAttribute('data-cats') || '').split(' ');
            const okCat = filter === 'all' || cats.includes(filter);
            const okSearch = term === '' || (card.getAttribute('data-search') || '').includes(term);
            return okCat && okSearch;
        };

        const render = () => {
            const PER_PAGE = perPage();
            const def = isDefault();

            const visible = cards.filter(c => matches(c));

            const totalPages = Math.max(1, Math.ceil(visible.length / PER_PAGE));
            if (page > totalPages) page = totalPages;
            const startIdx = (page - 1) * PER_PAGE;
            const endIdx = startIdx + PER_PAGE;

            cards.forEach(c => { c.style.display = 'none'; });
            visible.forEach((c, i) => { c.style.display = (i >= startIdx && i < endIdx) ? 'flex' : 'none'; });

            if (empty) empty.classList.toggle('hidden', !(visible.length === 0 && !def));

            // Pagination
            pager.innerHTML = '';
            if (totalPages <= 1) { pager.classList.add('hidden'); return; }
            pager.classList.remove('hidden');

            const mkBtn = (label: string, target: number, opts: { disabled?: boolean, active?: boolean, dots?: boolean } = {}) => {
                if (opts.dots) {
                    const span = document.createElement('span');
                    span.textContent = '…';
                    span.className = 'px-2 text-outline select-none';
                    pager.appendChild(span);
                    return;
                }
                const b = document.createElement('button');
                b.textContent = label;
                b.className = 'min-w-[38px] h-[38px] px-3 border text-sm font-bold transition-colors '
                    + (opts.active ? 'bg-primary text-white border-primary' : 'bg-white text-on-surface border-outline-variant hover:border-primary hover:text-primary')
                    + (opts.disabled ? ' opacity-40 cursor-not-allowed pointer-events-none' : '');
                if (opts.disabled) b.disabled = true;
                b.addEventListener('click', () => {
                    page = target;
                    render();
                    grid.scrollIntoView({ behavior: 'smooth', block: 'start' });
                });
                pager.appendChild(b);
            };

            mkBtn('‹', page - 1, { disabled: page === 1 });
            pageList(page, totalPages).forEach(p => {
                if (typeof p === 'string') mkBtn('', 0, { dots: true });
                else mkBtn(String(p), p, { active: p === page });
            });
            mkBtn('›', page + 1, { disabled: page === totalPages });
        };

        buttons.forEach(btn => btn.addEventListener('click', () => {
            buttons.forEach(b => {
                b.classList.remove('bg-primary', 'text-on-primary', 'border-primary');
                b.classList.add('border-outline-variant', 'text-on-surface-variant');
            });
            btn.classList.add('bg-primary', 'text-on-primary', 'border-primary');
            btn.classList.remove('border-outline-variant', 'text-on-surface-variant');
            filter = btn.getAttribute('data-filter') || 'all';
            page = 1;
            render();
        }));

        if (search) search.addEventListener('input', () => {
            term = search.value.trim().toLowerCase();
            page = 1;
            render();
        });

        // Re-paginate when crossing the mobile breakpoint (rotate/resize).
        window.matchMedia('(max-width: 767px)').onchange = () => { page = 1; render(); };

        render();
    };

    setupBlog();
    initForms();
    document.addEventListener('astro:after-swap', () => { setupBlog(); initForms(); });
</script>
