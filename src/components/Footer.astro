  linkedin:  { label: 'LinkedIn',  path: 'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z' },
  youtube:   { label: 'YouTube',   path: 'M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.872.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z' },
  x:         { label: 'X',         path: 'M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z' },
  tiktok:    { label: 'TikTok',    path: 'M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z' },
  whatsapp:  { label: 'WhatsApp',  path: 'M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.885-9.885 9.885m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z' },
  pinterest: { label: 'Pinterest', path: 'M12.017 0C5.396 0 .029 5.367.029 11.987c0 5.079 3.158 9.417 7.618 11.162-.105-.949-.199-2.403.041-3.439.219-.937 1.406-5.957 1.406-5.957s-.359-.72-.359-1.781c0-1.663.967-2.911 2.168-2.911 1.024 0 1.518.769 1.518 1.688 0 1.029-.653 2.567-.992 3.992-.285 1.193.6 2.165 1.775 2.165 2.128 0 3.768-2.245 3.768-5.487 0-2.861-2.063-4.869-5.008-4.869-3.41 0-5.409 2.562-5.409 5.199 0 1.033.394 2.143.889 2.741.099.12.112.225.085.345-.09.375-.293 1.199-.334 1.363-.053.225-.172.271-.402.165-1.495-.69-2.433-2.878-2.433-4.646 0-3.776 2.749-7.252 7.867-7.252 4.13 0 7.344 2.943 7.344 6.879 0 4.104-2.588 7.401-6.177 7.401-1.209 0-2.348-.63-2.734-1.373l-.744 2.836c-.269 1.036-.996 2.34-1.485 3.129C9.575 23.812 10.767 24 12.017 24c6.624 0 11.99-5.367 11.99-11.988C24.007 5.367 18.641.001 12.017.001z' },
};
const socials = (c1.socialLinks || [])
  .map((s: SocialLink) => ({ platform: one(s.platform), url: (s.url || '').trim() }))
  .filter((s: any) => s.url && s.url !== '#' && SOCIAL_ICONS[s.platform]);

// --- Columns 2,3,4 — fallback to default link columns ---
const defaultColumns: FooterColumn[] = [
  { title: "Products", links: [
    { label: "Flex Badges", url: "/products/flex" },
    { label: "Embroidery", url: "/products/embroidery" },
    { label: "PVC Patches", url: "/products/pvc" },
    { label: "Metal Badges", url: "/products/metal" }
  ]},
  { title: "Explore", links: [
    { label: "All Products", url: "/products" },
    { label: "Showcase", url: "/portfolio" },
    { label: "Blog", url: "/blog" }
  ]},
  { title: "Company", links: [
    { label: "Services", url: "/services" },
    { label: "Contact Us", url: "/contact" },
    { label: "Request a Quote", url: "/contact" }
  ]}
];
const columns: FooterColumn[] = (footerColumns && footerColumns.length > 0) ? footerColumns : defaultColumns;

// --- Absolute footer (below the line) — copyright (year auto) + credit ---
const currentYear = new Date().getFullYear();
const copyrightRaw = absoluteFooter?.copyright || '© 2024 Hong Yu Manufacturing. All rights reserved.';
const copyrightLine = copyrightRaw.replace(/\b(19|20)\d{2}\b/, String(currentYear));
const credit = absoluteFooter?.credit || 'Design by Vareno';
---

<footer class="bg-dark-navy text-white">
    <!-- Columns -->
    <div class="max-w-container-max mx-auto px-gutter py-xl grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-xl">
        <!-- Column 1: Brand block -->
        <div class="col-span-1">
            <a href="/" class="flex items-center gap-2 mb-6">
                {logoUrl && (
                    <img src={logoUrl} alt={companyName} loading="lazy" decoding="async" class="h-10 w-auto object-contain" />
                )}
                <span class="font-headline-md font-bold block text-white">{companyName}</span>
            </a>
            <p class="text-body-sm opacity-60 mb-6 max-w-xs">{description}</p>
            <div class="flex flex-col gap-2 mb-6 text-body-sm opacity-70">
                {phone && (
                    <a href={`tel:${phone.replace(/[^+\d]/g, '')}`} class="flex items-center gap-2 hover:text-white transition-colors">
                        <span class="material-symbols-outlined text-[18px]">call</span>{phone}
                    </a>
                )}
                {email && (
                    <a href={`mailto:${email}`} class="flex items-center gap-2 hover:text-white transition-colors">
                        <span class="material-symbols-outlined text-[18px]">mail</span>{email}
                    </a>
                )}
            </div>
            {socials.length > 0 && (
                <div class="flex gap-4">
                    {socials.map((s: any) => (
                        <a href={s.url} target="_blank" rel="noopener noreferrer"
                            title={SOCIAL_ICONS[s.platform].label} aria-label={SOCIAL_ICONS[s.platform].label}
                            class="text-white/70 hover:text-secondary-container transition-colors">
                            <svg viewBox="0 0 24 24" class="w-5 h-5" fill="currentColor" aria-hidden="true">
                                <path d={SOCIAL_ICONS[s.platform].path} />
                            </svg>
                        </a>
                    ))}
                </div>
            )}
        </div>
        <!-- Columns 2, 3, 4 -->
        {columns.map((col: any) => (
            <div>
                <h4 class="font-label-bold text-primary-fixed mb-6 uppercase tracking-widest text-xs">{col.title}</h4>
                <ul class="space-y-4 opacity-70">
                    {col.links?.map((link: any) => link.label && (
                        <li><a class="text-body-sm hover:text-white hover:underline transition-all" href={link.url}>{link.label}</a></li>
                    ))}
                </ul>
            </div>
        ))}
    </div>

    <!-- Absolute footer (below the line) -->
    <div class="max-w-container-max mx-auto px-gutter py-md border-t border-white/10 flex flex-col md:flex-row justify-between gap-md opacity-40 text-[12px]">
        <p>{copyrightLine}</p>
        <p>{credit}</p>
    </div>
</footer>
