---
interface FooterLink { label?: string; url?: string; }
interface FooterColumn { title?: string; links?: FooterLink[]; }
interface SocialLink { platform?: string | string[]; url?: string; }
interface Column1 {
  logo?: { node?: { sourceUrl?: string } } | null;
  companyName?: string;
  description?: string;
  phone?: string;
  email?: string;
  socialLinks?: SocialLink[] | null;
}
interface AbsoluteFooter { copyright?: string; credit?: string; }

interface Props {
  footerColumn1?: Column1 | null;
  footerColumns?: FooterColumn[] | null;
  absoluteFooter?: AbsoluteFooter | null;
}

const { footerColumn1, footerColumns, absoluteFooter } = Astro.props;

// --- Column 1 (brand block) — single editable group, with fallbacks ---
const c1: Column1 = footerColumn1 || {};
const logoUrl = c1.logo?.node?.sourceUrl || '';
const companyName = c1.companyName || 'Hong Yu';
const description = c1.description || 'Global leader in industrial custom badge manufacturing for corporate, military, and lifestyle brands.';
const phone = c1.phone || '';
const email = c1.email || '';
// Correct brand icons (inline SVG paths, viewBox 0 0 24 24). Each social row is
// shown only when the client has entered a URL; empty rows are hidden.
const one = (v: any) => (Array.isArray(v) ? v[0] : v);
const SOCIAL_ICONS: Record<string, { label: string; path: string }> = {
  facebook:  { label: 'Facebook',  path: 'M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z' },
