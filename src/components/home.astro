---
import Layout from '../layouts/Layout.astro';

interface Props {
  pageData?: any;
  portfolios?: any[];
  posts?: any[];
}

const { pageData, portfolios = [], posts = [] } = Astro.props;

// 1. Fallbacks for Hero Slides
const heroSlides = pageData?.heroSlides || [
  {
    badgeText: 'Custom Manufacturing',
    heading: 'Custom Badges, Patches & Metal Products Made for Your Brand',
    subheading: 'High-precision manufacturing for elite organizations. From 3D PVC patches to premium metal badges, we deliver industrial-grade custom products globally.',
    backgroundImage: { node: { sourceUrl: 'https://lh3.googleusercontent.com/aida-public/AB6AXuAyaphWdVdA51NWxn6qXq-7LvskppaGKPRmoPQkK_WYZptWXq-TU0hvjtHvA_Fp4tBVw_X_E9YYLA03pdNkHYToBgbvKbzP65xWjhdwLEQ97EE4ZkqPfrXSp0K4YnxHZQ1CoLPfMBYtnFsT3KBnuoEQ4tiXLauldgcKU75pPDl5FPtBOaZP1neblsL1Wz0nWDItpUN5p1PSk6v4lrkammbnL3vgUuhZHB_4a4OieZyUxBhEt16BJWQFOe0xWgTlmNDgIT3h0ayRGb2R' } },
    primaryCtaLabel: 'Get Your Free Design Proof',
    primaryCtaUrl: '/contact',
    secondaryCtaLabel: 'Explore Materials',
    secondaryCtaUrl: '/products'
