    primaryCtaLabel: 'Request PVC Quote',
    primaryCtaUrl: '/contact',
    secondaryCtaLabel: 'View PVC Options',
    secondaryCtaUrl: '/products#pvc-deep-dive'
  },
  {
    badgeText: 'Premium Metal Products',
    heading: 'Premium Metal Badges & Emblems for High-End Brand Programs',
    subheading: 'Elevate uniforms, packaging, vehicles, and accessories with refined metal finishes, precise tooling, and production-ready quality control.',
    backgroundImage: { node: { sourceUrl: 'https://lh3.googleusercontent.com/aida-public/AB6AXuBztqRgC0qgdOIXlzifLjK1UvH3JR_uHqjvSBHpSw-lTN7EKu-jjDUzNaeujqVbN_h3SiVRN0dmDk-VGWB6-yPa0_MOcSQrVfVVhiU6UfaZctKmIC1vfd6bDbSFHUMrAhwlVmeG7itJ2UbsRveQE1TvuumjgIZHa-DM22tKE3xI3I2ddkcpeVjrpzIOMlRffS0lJMJTUmiIYQMwfy4nq03UmNgy4y2AfS9pe8CLs2YWHRRQTWJgcUS8TX3_aLcp50gBkWvEIn3O' } },
    primaryCtaLabel: 'Start Metal Project',
    primaryCtaUrl: '/contact',
    secondaryCtaLabel: 'See Portfolio',
    secondaryCtaUrl: '/portfolio'
  }
];

// 1b. Hero trust bar (running strip under the banner)
const heroTrustBar = (pageData?.heroTrustBar && pageData.heroTrustBar.length > 0) ? pageData.heroTrustBar : [
  { icon: 'design_services', label: 'Free Proof' },
  { icon: 'payments', label: 'No Hidden Costs' },
  { icon: 'rocket_launch', label: 'Fast Turnaround' },
  { icon: 'public', label: 'Worldwide Shipping' },
  { icon: 'verified', label: 'Quality Control' }
];

// 2. Fallbacks for Manufacturing Specialties (Section 3)
const specialtiesTitle = pageData?.specialtiesTitle || 'Our Manufacturing Specialties';
const specialtiesSubtitle = pageData?.specialtiesSubtitle || 'Engineered for durability and visual impact across all industries.';
const specialties = (pageData?.specialties && pageData.specialties.length > 0) ? pageData.specialties : [
  { image: { node: { sourceUrl: 'https://lh3.googleusercontent.com/aida-public/AB6AXuAXevhRkt0YeraaUzM1V3xQXTu-8B3EbEcw5Ga6U-pSh5YYQvzaY8NDqvoJRz7yT97-yT8PurmJz3Y_IWem9e0Ou1pdgmlrP2_meYF2hHj-9Cz_R4R-I5xbc7xYHRSidQQobCilgdYS9OM_KAXw0K5bwwxCpFQuwrn41xoEx5CbcG-y-mPJU1nNV7wC597A8TYBuD6kJgpf478oaEdar9oMjujNA1Mxu9dvKNglEHyNc5Icx9rllWv7wzMp7TXyjNc80O0jZWY5J-Qn' } }, title: 'Flex Badges', description: 'High-resolution textured finish with 4-way stretch material.', linkLabel: 'Explore Flex →', linkUrl: '/products#flex-deep-dive' },
  { image: { node: { sourceUrl: 'https://lh3.googleusercontent.com/aida-public/AB6AXuDKS7mW3LoAZbQYOdPMsdAFxO0RAU3iNXmqX7-J6hiV-e2yI4lD-HLCoz6nWiVKMZXgeMMiAt032FtlgVXAxVIgBeQ839HrLMuBrEjngsGsnojdb32Gk2nysffLffitoVF7TkpN96d90Et4up32wdSooadkKpY1mp23nxpfIHsYEWbCm6Mynv5n9Pd9ys5q5PWV0zY6pWvHiBLoOW_Q_o3I0os45l4t3KqnL3o-kpRjpT5zHiquTaJ_B83zfhgZ7RXuqvi7Gl3Vm71s' } }, title: 'Embroidery', description: 'Classic premium stitch quality with up to 12 vibrant colors.', linkLabel: 'Explore Stitch →', linkUrl: '/products#embroidery-deep-dive' },
  { image: { node: { sourceUrl: 'https://lh3.googleusercontent.com/aida-public/AB6AXuCf3C-yh9W2g_Ohd5fCDwDWJQSAv4c6UC682WEHcXaCO_bEVNLCwTvjTAMBHQd1XrS2Er1Q0M8EvcAayNlKl2C67aqQJvqW167ZtlmTj4ZOUr4V-3tfbMCBmXyYzRaFwm_cW1qi62xLKHY7tNPLUsYR6ClTkbafMrPsrzn7oOTaJV5BQMkZYiKT_PiGQvOa9ACgyoMp-ADArS2C6rnDkb8d5ob-gpCo8iRd5I-rh_OtVdrSGNOj2dPscOzHeDnC6Y3elWOuijkmyWQ4' } }, title: 'PVC Patches', description: 'Tactical-grade 3D layering, 100% waterproof and fade resistant.', linkLabel: 'Explore PVC →', linkUrl: '/products#pvc-deep-dive' },
  { image: { node: { sourceUrl: 'https://lh3.googleusercontent.com/aida-public/AB6AXuCEN3vdbJEbtiIkznfsO9JjF7UO9QAXY_bbWSVta2EtmwFRVcDA8gyDzk6zydJ19_Ezqdj8Wl3_vk0gR41ecQFY6z4b-JbUiM0x6SVkxOof6aNg7qTyqK1mc7FJBWDe68nwyLY5Pt7PkAMTMYtuS6l-zO3XG9pHe8ylmPB1w5Gmu-D9OW6aUUqGsuunN8ormy-0jO2BP8AwEv5-dLs4elv2XZB2IMcVgcvq_NhI84EfUaFg-5_zXpStjv2uL2DpjtPc9aGrrq2WfVHV' } }, title: 'Metal Products', description: 'Die-struck lapel pins and badges with custom metal finishes.', linkLabel: 'Explore Metal →', linkUrl: '/products#metal-deep-dive' }
];

// 3. Fallbacks for Advantages Bento
const advantageTitle = pageData?.advantageTitle || 'The BadgeMaster Advantage';
const advantageSubtitle = pageData?.advantageSubtitle || 'Where precision engineering meets industrial capacity.';
const advantageBlocks = pageData?.advantageBlocks || [
  {
    icon: 'precision_manufacturing',
    title: 'Massive Production Capacity',
    description: 'Our facilities handle orders from 50 to 500,000 units with consistent precision across the entire run. We scale with your growth.',
    isHighlight: false,
    stats: [
      { value: '24/7', label: 'Manufacturing' },
      { value: '0.01mm', label: 'Tolerance' },
      { value: '100%', label: 'Custom' }
    ]
  },
  {
    icon: 'verified_user',
    title: 'ISO 9001 Certified',
    description: 'Every batch undergoes a rigorous 12-point inspection before it leaves our facility. Zero compromise on brand integrity.',
    isHighlight: true
  },
  {
    icon: 'palette',
    title: 'Pantone Matching',
    description: 'We ensure your brand colors are accurate to within 1% variance using professional matching systems.',
    isHighlight: false
  },
  {
    icon: 'inventory',
    title: 'White Label Shipping',
    description: 'For resellers and agencies, we offer fully anonymous blind shipping directly to your clients.',
    isHighlight: false
  },
  {
    icon: 'bolt',
    title: 'Priority Rush Lane',
    description: 'Urgent deadline? Our rush manufacturing can deliver finished custom products in as little as 5-7 business days.',
    isHighlight: true
  }
];

// 4. Fallbacks for Process Steps
const processTitle = pageData?.processTitle || 'Simple 3-Step Process';
const processSteps = pageData?.processSteps || [
  { icon: 'lightbulb', title: '1. Idea & Artwork', description: 'Upload a logo or simple sketch. Our design team creates your production-ready vector file for free.' },
  { icon: 'fact_check', title: '2. Digital Proof', description: 'Review a high-resolution mock-up in 24 hours. Request unlimited revisions until it\'s perfect.' },
  { icon: 'local_shipping', title: '3. Manufacturing', description: 'Once approved, we manufacture and ship worldwide. Track your order in real-time to your door.' }
];

// 5. Fallbacks for Technical Capabilities
const capabilitiesTitle = pageData?.capabilitiesTitle || 'Technical Capabilities';
const capabilitiesDescription = pageData?.capabilitiesDescription || 'Our production floor features cutting-edge CNC, laser, and textile machinery for complex custom specifications.';
const capabilitiesImageUrl = pageData?.capabilitiesImage?.node?.sourceUrl || 'https://lh3.googleusercontent.com/aida-public/AB6AXuA-frtc1bOyOK25pPGoe_4ZD20xuOwpW7_tfnfHYSeqmiLsLCcQrVSwPvqEvoEoU1PV2BpkaVuwXf8T-vNeRYDJNLK9B0IU6SxQdWAV7jNVow8WKE3h06rwuLEd8DuXVQXXEz3JNumytN90yQJQTYDFrsvOvV91O1O3gYr_aSTAtxWX2Mg_UI86V-_XmSZGtcxRgzMQ3khqurLXxK03eKOEVaoBUe5yaZCHhSugea6DTosDtS-n8QY53KzL70bZBdGVmDlMMDtshm-P';
const capabilitiesList = pageData?.capabilitiesList || [
  { title: 'Sizing', description: 'From 0.5" micro-pins to 18" large patches.' },
  { title: 'Backing', description: 'Iron-on, Velcro, Adhesive, or Magnetic.' },
  { title: 'Dimensions', description: 'Standard flat 2D or sculpted 3D layers.' },
  { title: 'Materials', description: 'TPU, Silicone, Brass, Zinc, and Eco-Felt.' }
];

// 6. Fallbacks for CTA Banner
const ctaTitle = pageData?.ctaTitle || 'Ready to Elevate Your Brand?';
const ctaText = pageData?.ctaText || 'Upload your artwork and receive a free digital proof with detailed material recommendations in 24 hours.';
const ctaBtnLabel = pageData?.ctaBtnLabel || 'Start Free Design Proof';
const ctaBtnUrl = pageData?.ctaBtnUrl || '/contact';
const ctaSecondaryLabel = pageData?.ctaSecondaryLabel || 'Contact Sales Team';
const ctaSecondaryUrl = pageData?.ctaSecondaryUrl || '/contact';

// Section headings + CTAs (Recent Work & Insights)
const portfolioSectionTitle = pageData?.portfolioSectionTitle || 'Our Recent Work';
const portfolioSectionSubtitle = pageData?.portfolioSectionSubtitle || '';
const portfolioCtaLabel = pageData?.portfolioCtaLabel || 'View Case Studies';
const portfolioCtaUrl = pageData?.portfolioCtaUrl || '/portfolio';
const blogSectionTitle = pageData?.blogSectionTitle || 'Industry Insights';
const blogCtaLabel = pageData?.blogCtaLabel || 'Browse All Articles';
const blogCtaUrl = pageData?.blogCtaUrl || '/blog';

// 7. Fallbacks for Portfolios (recent work grid)
const defaultPortfolios = [
  {
    title: 'Elite Tactical Badge', slug: 'elite-tactical-badge',
    featuredImage: { node: { sourceUrl: 'https://lh3.googleusercontent.com/aida-public/AB6AXuDRBf_raBYbIRrpMiZUJRdGIojqK3hBrvii21RMfm98VQS3gecMPHomLfe_e-Gt6prhNBbBiUZE8bQIT139h047kGDNjrnYq5MdBoDW-y_Sxr5-3LCWKVefea-mC-TNHXYcgohqYLBknmDDs6rNK6my1-U1FSeDCbsZVKJJ2nIrwBxXimFzbj5fpB-lHGFlioqLb5wHfLWduH4VTnsOLFKd1xKxM8wqXVwUDtHTHpCbhmvRy8k3PBnk5S9Yjb-qonIXTwTy_02jkBcO' } },
    portfolioCategories: { nodes: [{ name: 'Flex Badges' }] }
  },
  {
    title: 'Heritage Airline Crest', slug: 'heritage-airline-crest',
    featuredImage: { node: { sourceUrl: 'https://lh3.googleusercontent.com/aida-public/AB6AXuB1EX8Yoan2du0bcQxo2lml-OdMNBH_MqGGS6GLVmIEHueue7FTRWXFDC4x1BU87wUQivjcoIcjh5rS1vQ6FcHPDhdEd8Vjko6gT6tC4WAJvI-DkBrhlyuEMkOY7cJBnMG_vhYhRoxrzHp_SCkq35nnX6vcSi-i36OTVFCoVgAG1nhWqwCF0oQnqp6VP9zn7_2lYbbGIHZlTIAerlSZ8sju0mVCUoOBe09Wr9eOMhP-N5-9mlLRAJ1K3jkcr34DRGzl8yzxrPNe9d80' } },
    portfolioCategories: { nodes: [{ name: 'Embroidery' }] }
  },
  {
    title: 'Maritime Service Coin', slug: 'maritime-service-coin',
    featuredImage: { node: { sourceUrl: 'https://lh3.googleusercontent.com/aida-public/AB6AXuBRWAJExJojzABX_KK-k9Q4nntTpyavJlGfwXi2zz5fNBckvSPlcWZnMTzj7UpEzSBAvrH5NxGRUXNDW6NoAE88M1zCW2SMdO0Jn8JtcyU29KIws1JSkibufsNopBqQt-9mO11GY2vXaoE-7VVM5fcEKf_XtalA6Td5mMb3BMI7Ivs5-0Elsu4Zg-3H9mCyVfou-8pEh_b0WW4bzr6GQ7gkG9QMmHHaxKmHA1O31pe22qlCv7ZlmizNxoZT_bkOFU6GQ5Ymsq_7tEP6' } },
    portfolioCategories: { nodes: [{ name: 'Metal Products' }] }
  },
  {
    title: 'Luxury Automotive Badge', slug: 'luxury-automotive-badge',
    featuredImage: { node: { sourceUrl: 'https://lh3.googleusercontent.com/aida-public/AB6AXuCZytY5GwgQfFu3JKdsc66nraRX2fQZdP8gtjzfHc_MjMWPWZJhdHTJrMDYdP6appA6xqxJpnA2vYUZ-5fm9xktaroENikcwWvdOSgN9JGgyUrD3asUCxDC5rR7pdGTcDW3f-f9BQZvO7pcrwf6xDo170TBrxImLmYOhCms3M_Xcc76ygfenWtapjrmJn3WMWkTx0KVgCZLSDFnmd_T5nsrExdDb_jA0-N1OEWdtL_ZUoWXvlizQX5w97-RGySiVDSIbX_JL_DY3Z_7' } },
    portfolioCategories: { nodes: [{ name: 'Metal Products' }] }
  }
];
const displayPortfolios = portfolios.length > 0 ? portfolios : defaultPortfolios;

// "Our Recent Work" filter: category key (slug if present, else derived from name) so buttons match cards
const catKey = (c: any) => c?.slug || (c?.name || '').toLowerCase().split(/\s+/)[0];
const recentCardCats = (p: any) => (p?.portfolioCategories?.nodes || []).map(catKey).filter(Boolean).join(' ');
const recentCatMap = new Map<string, string>();
displayPortfolios.forEach((p: any) => (p?.portfolioCategories?.nodes || []).forEach((c: any) => {
  const k = catKey(c);
  if (k) recentCatMap.set(k, c?.name || k);
}));
// Filter tabs the client picked in the admin (Home → Recent Work → Recent Categories).
// If none are picked, fall back to auto-deriving them from the displayed projects.
const selectedRecentCats = (pageData?.recentCategories?.nodes || [])
  .map((c: any) => ({ key: catKey(c), name: c?.name || '' }))
  .filter((c: any) => c.key && c.name);
const recentCats = selectedRecentCats.length > 0
  ? selectedRecentCats
  : [...recentCatMap].map(([key, name]) => ({ key, name }));

// 8. Fallbacks for Blog Posts
const defaultPosts = [
  {
    title: 'PVC vs. Embroidery: Choosing for Performance',
    slug: 'pvc-vs-embroidery',
    excerpt: 'Detailed comparison of durability and design fidelity for tactical gear.',
    featuredImage: { node: { sourceUrl: 'https://lh3.googleusercontent.com/aida-public/AB6AXuDHYuHREJz_TSGrZE0pHQes8y9te0cgs9AREaogPbPhYeKK6_PON0Wv8BqsVdO4-nPlEVv27Yz6nUit2_yyYKvkUdm0b-qjR6nYMf_hFF7J_clZdTcXMkbeOKd1ghlF6BUazP2WCFRr_rY0ucH0TjKbo-925DwSmOQzxzSUBHSkw8naUedIGcxiPU1-YWTHAWNnZ7t73MLAQ1WcHgvuBEdjf0seiA1f6C7vZsCCMT7vDnzbklV9WtvAWBC6RN6lfN6dfZkeJTQX9zRE' } },
    categories: { nodes: [{ name: 'Tech Trends' }] }
  },
  {
    title: 'Understanding Bleeds & Borders for CNC Milling',
    slug: 'understanding-bleeds-borders',
    excerpt: 'Crucial artwork guidelines for creating metallic pins with enamel color separation.',
    featuredImage: { node: { sourceUrl: 'https://lh3.googleusercontent.com/aida-public/AB6AXuD3FYVvxcQTTmW6FDEQitaXXk281hEj24yz25fVKoFNRmI9hdmBz4Tb9JsmJkqLBY9DLhs7xnDkZtfvC_y9qh8DsqN7suyb0fj_sjGNsCMQFuVRLbxCDx5sQHwKZLKzG12Z9F8h3SAzL1C9AwNR-5OyjWEyKzgiQaxNE4ILT5-2gdXwz58XiN9rOiSaQS5DhrfaLlIG1DN033VLthN73i3inMYqx6oPuBjSYWu-WeZgAzY5XoQr9lyc8OMqVvSJcLWQu_Oh6glFPoS8' } },
    categories: { nodes: [{ name: 'Ordering Guide' }] }
  },
  {
    title: 'What are Flex Badges? The Modern Standard',
    slug: 'what-are-flex-badges',
    excerpt: 'Discover the texture, feel, and weight advantages of our patented metallic-polymer badges.',
    featuredImage: { node: { sourceUrl: 'https://lh3.googleusercontent.com/aida-public/AB6AXuB5R6LwK56WjXTHcTshQhsy0cR1yWnaF3vjdvadVO4ZlesQ0iiaD1UF141i0S7BDEI9udcI4YQ_CBFb1uZ1lNBb1tRFwswrK11bpmBIEJD-t0WU2TxW0wb7JiqCWRs6c73-4lk7KT2vtbR_mDzSGURhJZv5TItVzOSy63rF4f7TgY0nSV3QFPuYUyzEl-fHXZVkMEP9Ir39i0soTsJkXE9VWs4O9MjlTqPYFKC2z6ZgI5VCr9VVn_ZdPqvOm3xuSpLpu04tHtEIDp-x' } },
    categories: { nodes: [{ name: 'Material Spec' }] }
  }
];
const displayPosts = posts.length > 0 ? posts : defaultPosts;
---

<Layout title="BadgeMaster | Custom Badges, Patches & Metal Products" heroHeader={true}>
    <main>
        <!-- Section 1: Modern Hero Slider (Dynamic) -->
        <section class="relative overflow-hidden border-b border-outline-variant bg-inverse-surface" id="hero-slider">
            {heroSlides.map((slide, idx) => (
                <div class={idx === 0 ? "hero-slide is-active" : "hero-slide"} data-hero-slide>
                    {slide.backgroundImage?.node?.sourceUrl && (
                        <img alt={slide.heading} class="hero-bg" src={slide.backgroundImage.node.sourceUrl} />
                    )}
                    <div class="hero-overlay"></div>
                    <div class="relative z-10 max-w-container-max mx-auto px-gutter min-h-[560px] md:min-h-[640px] flex items-center">
                        <div class="max-w-3xl py-xl hero-content">
                            <p class="font-label-bold text-label-bold text-cta-orange uppercase tracking-widest mb-sm">
                                {slide.badgeText}
                            </p>
                            <h1 class="font-display-lg text-display-lg text-white mb-md lg:text-[56px] leading-[1.1]">
                                {slide.heading}
                            </h1>
                            <p class="font-body-lg text-body-lg text-white/85 mb-xl max-w-2xl">
                                {slide.subheading}
                            </p>
                            <div class="flex flex-wrap gap-md mb-lg hero-actions">
                                {slide.primaryCtaLabel && (
                                    <a href={slide.primaryCtaUrl}
                                        class="inline-block bg-cta-orange text-white px-lg py-3 font-label-bold text-label-bold rounded shadow-md hover:opacity-95 transition-all text-center">
                                        {slide.primaryCtaLabel}
                                    </a>
                                )}
                                {slide.secondaryCtaLabel && (
                                    <a href={slide.secondaryCtaUrl}
                                        class="inline-block bg-white text-primary px-lg py-3 font-label-bold text-label-bold rounded shadow-md hover:bg-white/90 transition-all text-center">
                                        {slide.secondaryCtaLabel}
                                    </a>
                                )}
                            </div>
                        </div>
                    </div>
                </div>
            ))}
            
            <!-- Hero Slider Bottom Bar -->
            <div class="absolute left-0 right-0 bottom-0 z-20 bg-dark-navy/90 border-t border-white/10 backdrop-blur-sm">
                <div class="max-w-container-max mx-auto px-gutter py-4 flex flex-col lg:flex-row lg:items-center lg:justify-between gap-md">
                    <div class="grid grid-cols-2 md:grid-cols-5 items-start gap-sm md:gap-md text-white">
                        {heroTrustBar.map((trust: any) => (
                            <div class="flex items-center gap-2">
                                <span class="material-symbols-outlined text-secondary-container" data-icon={trust.icon}>{trust.icon}</span>
                                <span class="font-label-bold text-sm">{trust.label}</span>
                            </div>
                        ))}
                    </div>
                    <div class="flex items-center justify-between lg:justify-end gap-md">
                        <div class="flex items-center gap-sm" aria-label="Hero slider dots">
                            {heroSlides.map((_, idx) => (
                                <button class={idx === 0 ? "hero-dot is-active h-2 w-2 rounded-full bg-white/50 transition-all" : "hero-dot h-2 w-2 rounded-full bg-white/50 transition-all"}
                                    type="button" data-hero-dot aria-label={`Go to slide ${idx + 1}`}></button>
                            ))}
                        </div>
                        <div class="flex items-center gap-sm" aria-label="Hero slider controls">
                            <button class="w-10 h-10 border border-white/30 text-white bg-white/10 hover:bg-white/20 transition-colors flex items-center justify-center"
                                type="button" data-hero-prev aria-label="Previous slide">
                                <span class="material-symbols-outlined">chevron_left</span>
                            </button>
                            <button class="w-10 h-10 border border-white/30 text-white bg-white/10 hover:bg-white/20 transition-colors flex items-center justify-center"
                                type="button" data-hero-next aria-label="Next slide">
                                <span class="material-symbols-outlined">chevron_right</span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Section 3: Specialties (Dynamic) -->
        <section class="py-xl bg-surface">
            <div class="max-w-container-max mx-auto px-gutter">
                <div class="mb-xl text-center">
                    <h2 class="font-headline-lg text-headline-lg text-primary mb-sm">{specialtiesTitle}</h2>
                    <p class="font-body-lg text-body-lg text-on-surface-variant max-w-2xl mx-auto">{specialtiesSubtitle}</p>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-gutter">
                    {specialties.map((item: any) => (
                        <div class="bg-white group cursor-pointer border border-outline-variant overflow-hidden hover:shadow-lg transition-shadow">
                            <div class="h-64 overflow-hidden">
                                {item.image?.node?.sourceUrl && (
