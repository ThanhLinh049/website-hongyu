---
import Layout from '../layouts/Layout.astro';
import { PRODUCTS_CATEGORIES, PRODUCTS_TEXTURES, PRODUCTS_BACKINGS, PRODUCTS_LIST } from '../lib/defaults';

interface Props {
  pageData?: any;
  categories?: any[];
  products?: any[];
  finishes?: any[];
  backings?: any[];
  seo?: any;
}

const { pageData, categories = [], products = [], finishes = [], backings = [], seo } = Astro.props;

// Hero
const heroEyebrow = pageData?.heroEyebrow || 'B2B Industrial Manufacturing';
const heroTitle = pageData?.heroTitle || 'Precision Engineered <br />Custom Product Catalogue';
const heroDescription = pageData?.heroDescription || 'Scale your brand identity with our certified manufacturing capabilities. High-fidelity badges, technical PVC, and premium metal components for global procurement.';
const heroCtaLabel = pageData?.heroCtaLabel || 'Download Full Catalogue';
const heroCtaUrl = pageData?.heroCtaUrl || '';
// Only show the catalogue button when a real link/PDF is set (avoid a dead "#" link).
const hasCatalogue = !!heroCtaLabel && !!heroCtaUrl && heroCtaUrl !== '#';
const heroImage = pageData?.heroImage?.node?.sourceUrl || '';

// Section headings (client-editable via WP)
const categoriesTitle = pageData?.categoriesTitle || 'Explore Our Product Ranges';
const categoriesSubtitle = pageData?.categoriesSubtitle || 'Choose a category to view its full catalogue, technical specifications, and finishes.';
const allProductsTitle = pageData?.allProductsTitle || 'All Products';

// Category cards (from the product-category terms)
const catCards = (categories && categories.length > 0) ? categories : PRODUCTS_CATEGORIES;
const catImg = (c: any) => c?.categoryFields?.catHeroImage?.node?.sourceUrl || '';

// All products
const allProducts = (products && products.length > 0) ? products : PRODUCTS_LIST;
const prodImg = (p: any) => p?.featuredImage?.node?.sourceUrl || '';
const prodLink = (p: any) => {
  return `/products/${p.slug}`;
};
const prodFinishes = (p: any) => (p?.finishes?.nodes || []).map((x: any) => x.slug).join(' ');
const prodBackings = (p: any) => (p?.backings?.nodes || []).map((x: any) => x.slug).join(' ');
// Filter facets (dynamic from taxonomy terms; client-managed). Fall back to nothing if empty.
const finishFacet = finishes || [];
const backingFacet = backings || [];

// Finishes & Materials
const finishesTitle = pageData?.finishesTitle || 'Finishes & Materials';
const finishesDescription = pageData?.finishesDescription || "Customize your product to match your brand's tactile and visual requirements.";
const surfaceTexturesTitle = pageData?.surfaceTexturesTitle || 'Surface Textures';
const surfaceTextures = (pageData?.surfaceTextures && pageData.surfaceTextures.length > 0) ? pageData.surfaceTextures : PRODUCTS_TEXTURES;
const backingTitle = pageData?.backingTitle || 'Backing Solutions';
const backingSolutions = (pageData?.backingSolutions && pageData.backingSolutions.length > 0) ? pageData.backingSolutions : PRODUCTS_BACKINGS;
const texImg = (t: any) => t?.swatchImage?.node?.sourceUrl || '';

// Final CTA
const ctaTitle = pageData?.ctaTitle || 'Not sure which product fits your needs?';
const ctaText = pageData?.ctaText || 'Our material specialists are ready to guide you through technical selections, design optimization, and B2B volume pricing.';
const ctaPrimaryLabel = pageData?.ctaPrimaryLabel || 'Talk to Our Product Specialist';
const ctaPrimaryUrl = pageData?.ctaPrimaryUrl || '/contact';
const ctaSecondaryLabel = pageData?.ctaSecondaryLabel || 'Request Free Sample Kit';
const ctaSecondaryUrl = pageData?.ctaSecondaryUrl || '/contact';
---

<Layout title="All Products | Hong Yu Manufacturing" seo={seo} description={heroDescription}>
    <main class="w-full">
        <!-- Hero (image banner, left-aligned — consistent with the Showcase & Blog pages) -->
        <section id="products-hero" class="relative bg-primary py-xl flex items-center min-h-[260px] md:min-h-[504px] overflow-hidden">
            {heroImage && (
                <div class="absolute inset-0 pointer-events-none">
                    <img alt={heroEyebrow} fetchpriority="high" decoding="async" class="w-full h-full object-cover opacity-90" src={heroImage} />
                    <div class="absolute inset-0 bg-gradient-to-r from-primary via-primary/85 to-primary/40"></div>
                </div>
            )}
            <div class="container max-w-container-max mx-auto px-gutter relative z-10">
                <div class="max-w-3xl">
                    <div class="flex items-center gap-sm mb-sm">
                        <span class="font-label-bold text-label-bold text-cta-orange uppercase tracking-[0.2em] text-[12px]">{heroEyebrow}</span>
                    </div>
                    <h1 class="font-display-lg text-white mb-md text-[22px] sm:text-[30px] lg:text-[44px] leading-[1.15] tracking-tight" set:html={heroTitle}></h1>
                    <p class="font-body-lg text-white/80 mb-lg max-w-xl">{heroDescription}</p>
                    {hasCatalogue && (
                        <div class="flex flex-wrap gap-md hero-actions">
                            <a href={heroCtaUrl} class="bg-cta-orange text-white px-md py-3 rounded font-label-bold uppercase tracking-wider hover:brightness-110 transition-all text-center">{heroCtaLabel}</a>
                        </div>
                    )}
                </div>
            </div>
        </section>

        <!-- Browse by category -->
        <section class="py-xl bg-surface-container-low border-b border-outline-variant">
            <div class="container max-w-container-max mx-auto px-gutter">
                <div class="mb-lg text-center max-w-2xl mx-auto">
                    <h2 class="font-headline-lg text-headline-lg text-primary mb-sm">{categoriesTitle}</h2>
                    {categoriesSubtitle && (<p class="text-on-surface-variant font-body-md">{categoriesSubtitle}</p>)}
                </div>
                <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-gutter">
                    {catCards.map((c: any) => (
                        <a class="group card-lift bg-white border border-outline-variant hover:border-primary overflow-hidden flex flex-col" href={`/products/${c.slug}`}>
                            <div class="aspect-square overflow-hidden bg-surface-container relative">
                                {catImg(c) && (
                                    <img alt={c.name} loading="lazy" decoding="async" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" src={catImg(c)} />
                                )}
                                {typeof c.count === 'number' && c.count > 0 && (
                                    <span class="absolute top-3 right-3 bg-white/90 backdrop-blur-sm px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-widest text-primary shadow-sm">{c.count} items</span>
                                )}
                            </div>
                            <div class="p-3 sm:p-md text-center flex flex-col flex-grow">
                                <h3 class="font-headline-sm text-sm sm:text-base text-primary mb-xs group-hover:text-cta-orange transition-colors">{c.name}</h3>
                                <span class="mt-auto inline-flex items-center justify-center gap-1 text-cta-orange font-bold text-[11px] sm:text-sm uppercase tracking-wide group-hover:text-primary transition-colors">
                                    View Range <span class="material-symbols-outlined text-[15px] sm:text-[18px] transition-transform group-hover:translate-x-1">arrow_forward</span>
                                </span>
                            </div>
                        </a>
                    ))}
                </div>
            </div>
        </section>

        <!-- All Products: sidebar filters + grid -->
        <section class="py-xl">
            <div class="container max-w-container-max mx-auto px-gutter">
                <div class="mb-lg">
                    <h2 class="font-headline-lg text-headline-lg text-primary">{allProductsTitle}</h2>
                </div>
                <div class="grid grid-cols-1 lg:grid-cols-4 gap-md lg:gap-gutter items-start">
                    <!-- Sidebar: 1 of 4 equal columns (sticky). Search + filters as one clear panel, split by a divider. -->
                    <aside class="lg:col-span-1 lg:sticky lg:top-[96px]">
                        <div class="bg-white border border-outline-variant rounded-lg divide-y divide-outline-variant overflow-hidden">
                            <!-- Search -->
                            <div class="p-md">
                                <h4 class="font-label-bold text-primary text-[11px] uppercase tracking-widest mb-sm">Quick Search</h4>
                                <div class="relative">
                                    <input id="prod-search" type="text" placeholder="SKU or Name..." class="w-full pl-3 pr-9 py-2 rounded bg-surface-container-low border border-outline-variant focus:bg-white focus:ring-1 focus:ring-primary focus:border-primary text-sm" />
                                    <span class="material-symbols-outlined absolute right-2.5 top-1/2 -translate-y-1/2 text-outline text-[18px] pointer-events-none">search</span>
                                </div>
                            </div>
                            <!-- Filters -->
                            <div class="p-md space-y-md">
                                {finishFacet.length > 0 && (
                                    <div>
                                        <h4 class="font-label-bold text-primary text-[11px] uppercase tracking-widest mb-sm">Finish</h4>
                                        <div class="grid grid-cols-2 lg:grid-cols-1 gap-x-md gap-y-xs">
                                            {finishFacet.map((f: any) => (
                                                <label class="flex items-center gap-sm text-sm text-on-surface-variant cursor-pointer hover:text-primary transition-colors">
                                                    <input type="checkbox" class="facet-finish accent-primary w-4 h-4" value={f.slug} />
                                                    {f.name}
                                                </label>
                                            ))}
                                        </div>
                                    </div>
                                )}
                                {backingFacet.length > 0 && (
                                    <div>
                                        <h4 class="font-label-bold text-primary text-[11px] uppercase tracking-widest mb-sm">Backing</h4>
                                        <div class="grid grid-cols-2 lg:grid-cols-1 gap-x-md gap-y-xs">
                                            {backingFacet.map((b: any) => (
                                                <label class="flex items-center gap-sm text-sm text-on-surface-variant cursor-pointer hover:text-primary transition-colors">
                                                    <input type="checkbox" class="facet-backing accent-primary w-4 h-4" value={b.slug} />
                                                    {b.name}
                                                </label>
                                            ))}
                                        </div>
                                    </div>
                                )}
                                <button id="reset-filters" type="button" class="w-full py-2 rounded bg-surface-container text-label-bold uppercase text-[11px] tracking-widest hover:bg-outline-variant transition-colors">Reset All Filters</button>
                            </div>
                        </div>
                    </aside>

                    <!-- Grid column: spans 3 of 4 columns, 3-up card grid (each card = same width as the filter) -->
                    <div class="lg:col-span-3">
                        <div class="flex items-center justify-between mb-lg border-b border-outline-variant pb-base">
                            <p class="text-sm text-outline">Showing <span id="shown-count" class="text-on-background font-bold">0</span> of <span id="total-count" class="text-on-background font-bold">{allProducts.length}</span> products</p>
                            <div class="flex items-center gap-xs">
                                <select id="prod-sort" aria-label="Sort products" class="text-sm font-bold bg-white border border-outline-variant px-sm py-2 focus:ring-1 focus:ring-primary focus:border-primary cursor-pointer text-primary">
                                    <option value="" disabled selected hidden>Sort by</option>
                                    <option value="default">Featured</option>
                                    <option value="az">Name (A-Z)</option>
                                    <option value="newest">Newest</option>
                                </select>
                            </div>
                        </div>
                        {allProducts.length > 0 ? (
                            <div id="prod-grid" class="grid grid-cols-2 md:grid-cols-3 gap-md">
                                {allProducts.map((p: any) => (
                                    <a href={prodLink(p)}
                                        class="product-card card-lift bg-white border border-outline-variant hover:border-primary group overflow-hidden flex flex-col"
                                        data-name={(p.title || '').toLowerCase()} data-date={p.date || ''} data-finish={prodFinishes(p)} data-backing={prodBackings(p)}>
                                        <div class="aspect-square bg-surface-container relative overflow-hidden">
                                            {prodImg(p) && (<img loading="lazy" decoding="async" src={prodImg(p)} alt={p.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />)}
                                        </div>
                                        <div class="p-md flex flex-col flex-grow">
                                            <h4 class="font-headline-sm text-sm text-primary mb-md flex-grow group-hover:text-cta-orange transition-colors">{p.title}</h4>
                                            <span class="inline-flex items-center gap-1 text-cta-orange font-bold text-[12px] uppercase tracking-wider group-hover:text-primary transition-colors">
                                                View Details <span class="material-symbols-outlined text-[16px] transition-transform group-hover:translate-x-1">arrow_forward</span>
                                            </span>
                                        </div>
                                    </a>
                                ))}
                            </div>
                        ) : (
                            <p class="text-outline py-lg">No products available yet.</p>
                        )}
                        <div id="prod-empty" class="hidden text-center py-xl text-outline">
                            <span class="material-symbols-outlined text-5xl mb-sm block">search_off</span>
                            No products match your filters.
                        </div>
                        <div id="prod-pagination" class="mt-xl flex justify-center items-center gap-xs flex-wrap"></div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Finishes & Materials (heading left, swatch grid + backing right) -->
        <section class="py-xl bg-surface">
            <div class="container max-w-container-max mx-auto px-gutter">
                <div class="grid grid-cols-1 lg:grid-cols-12 gap-xl items-start">
                    <!-- Left: intro (sticky on desktop) -->
                    <div class="lg:col-span-4 lg:sticky lg:top-[96px]">
                        <h2 class="font-headline-lg text-headline-lg text-primary mb-md">{finishesTitle}</h2>
                        {finishesDescription && (<p class="text-on-surface-variant font-body-md mb-md">{finishesDescription}</p>)}
                        <div class="w-16 h-1 bg-primary"></div>
                    </div>

                    <!-- Right: surface textures (fills the row; grows to any number of swatches) + backing -->
                    <div class="lg:col-span-8 space-y-lg">
                        <div>
                            <h5 class="font-label-bold uppercase text-[11px] tracking-widest text-primary mb-md">{surfaceTexturesTitle}</h5>
                            <div class="grid grid-cols-3 sm:grid-cols-4 lg:grid-cols-5 gap-md">
                                {surfaceTextures.map((tex: any) => (
                                    <div class="text-center group">
                                        <div class="aspect-square rounded-lg overflow-hidden bg-surface-container border border-outline-variant group-hover:border-primary transition-colors mb-xs">
                                            {texImg(tex) && (<img src={texImg(tex)} alt={tex.textureName} loading="lazy" class="w-full h-full object-cover" />)}
                                        </div>
                                        <span class="text-[10px] font-bold uppercase tracking-wide">{tex.textureName}</span>
                                    </div>
                                ))}
                            </div>
                        </div>
                        <div>
                            <h5 class="font-label-bold uppercase text-[11px] tracking-widest text-primary mb-sm">{backingTitle}</h5>
                            <div class="flex flex-wrap gap-sm">
                                {backingSolutions.map((b: any) => (
                                    <span class="px-sm py-xs bg-white border border-outline-variant rounded text-[12px] font-bold hover:border-primary transition-colors">{b.label}</span>
                                ))}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Final CTA -->
        <section class="py-xl bg-primary text-white text-center">
            <div class="container max-w-container-max mx-auto px-gutter">
                <h2 class="font-headline-lg text-headline-lg mb-md">{ctaTitle}</h2>
                <p class="font-body-lg text-white/70 mb-xl max-w-2xl mx-auto">{ctaText}</p>
                <div class="flex flex-col sm:flex-row items-center justify-center gap-md">
                    {ctaPrimaryLabel && (
                        <a href={ctaPrimaryUrl} class="inline-block bg-cta-orange text-white px-xl py-md rounded font-label-bold uppercase tracking-widest text-lg hover:brightness-110 transition-all text-center font-black">{ctaPrimaryLabel}</a>
                    )}
                    {ctaSecondaryLabel && ctaSecondaryUrl !== ctaPrimaryUrl && (
                        <a href={ctaSecondaryUrl} class="inline-block border border-white/30 hover:bg-white/10 text-white px-xl py-md rounded font-label-bold uppercase tracking-widest text-lg transition-all text-center font-black">{ctaSecondaryLabel}</a>
                    )}
                </div>
            </div>
        </section>
    </main>

    <script>
        // All Products: category filter + search + sort + numbered pagination
        const setupCatalogue = () => {
            const grid = document.getElementById('prod-grid');
            if (!grid) return;
            const cards = Array.from(grid.querySelectorAll('.product-card')) as HTMLElement[];
            const search = document.getElementById('prod-search') as HTMLInputElement | null;
            const sortSel = document.getElementById('prod-sort') as HTMLSelectElement | null;
            const pag = document.getElementById('prod-pagination');
            const shown = document.getElementById('shown-count');
            const total = document.getElementById('total-count');
            const empty = document.getElementById('prod-empty');
            const facetFinish = Array.from(document.querySelectorAll('.facet-finish')) as HTMLInputElement[];
            const facetBacking = Array.from(document.querySelectorAll('.facet-backing')) as HTMLInputElement[];
            const resetBtn = document.getElementById('reset-filters');
            // 4 per page on mobile (≤767px), 9 on tablet/desktop.
            const perPage = () => window.matchMedia('(max-width: 767px)').matches ? 4 : 9;
            let term = '';
            let page = 1;
            let order = cards.slice();

            const checked = (inputs: HTMLInputElement[]) => inputs.filter(i => i.checked).map(i => i.value);
            const hasAny = (vals: string[], sel: string[]) => sel.length === 0 || sel.some(s => vals.includes(s));
            const matches = (c: HTMLElement) => {
                if (term && !(c.dataset.name || '').includes(term)) return false;
                const fin = (c.dataset.finish || '').split(' ');
                const bak = (c.dataset.backing || '').split(' ');
                return hasAny(fin, checked(facetFinish)) && hasAny(bak, checked(facetBacking));
            };

            const pageList = (totalPages: number): (number | string)[] => {
                if (totalPages <= 7) return Array.from({ length: totalPages }, (_, i) => i + 1);
                const out: (number | string)[] = [1];
                const start = Math.max(2, page - 1), end = Math.min(totalPages - 1, page + 1);
                if (start > 2) out.push('…');
                for (let i = start; i <= end; i++) out.push(i);
                if (end < totalPages - 1) out.push('…');
                out.push(totalPages);
                return out;
            };

            const renderPagination = (totalPages: number) => {
                if (!pag) return;
                pag.innerHTML = '';
                if (totalPages <= 1) return;
                const mk = (label: string, target: number, opts: { active?: boolean, disabled?: boolean } = {}) => {
                    const b = document.createElement('button');
                    b.type = 'button';
                    b.textContent = label;
                    b.className = 'min-w-[38px] h-[38px] px-3 border text-sm font-bold transition-colors ' +
                        (opts.active ? 'bg-primary text-white border-primary' : 'bg-white text-on-surface border-outline-variant hover:border-primary hover:text-primary') +
                        (opts.disabled ? ' opacity-40 cursor-not-allowed pointer-events-none' : '');
                    if (!opts.disabled && !opts.active) b.addEventListener('click', () => { page = target; render(); grid.scrollIntoView({ behavior: 'smooth', block: 'start' }); });
                    else if (opts.active) b.addEventListener('click', () => {});
                    return b;
                };
                pag.appendChild(mk('‹', page - 1, { disabled: page === 1 }));
                pageList(totalPages).forEach(p => {
                    if (p === '…') { const s = document.createElement('span'); s.textContent = '…'; s.className = 'px-2 text-outline'; pag.appendChild(s); }
                    else { const n = p as number; pag.appendChild(mk(String(n), n, { active: n === page })); }
                });
                pag.appendChild(mk('›', page + 1, { disabled: page === totalPages }));
            };

            const render = () => {
                const PER_PAGE = perPage();
                const matched = order.filter(matches);
                const totalPages = Math.max(1, Math.ceil(matched.length / PER_PAGE));
                if (page > totalPages) page = totalPages;
                cards.forEach(c => { c.style.display = 'none'; });
                const from = (page - 1) * PER_PAGE;
                matched.slice(from, from + PER_PAGE).forEach(c => { c.style.display = 'flex'; });
                if (total) total.textContent = String(matched.length);
                if (shown) shown.textContent = matched.length === 0 ? '0' : `${from + 1}–${Math.min(from + PER_PAGE, matched.length)}`;
                if (empty) empty.classList.toggle('hidden', matched.length !== 0);
                renderPagination(totalPages);
            };

            search?.addEventListener('input', () => { term = (search.value || '').trim().toLowerCase(); page = 1; render(); });
            [...facetFinish, ...facetBacking].forEach(cb => cb.addEventListener('change', () => { page = 1; render(); }));
            resetBtn?.addEventListener('click', () => {
                term = '';
                if (search) search.value = '';
                [...facetFinish, ...facetBacking].forEach(cb => { cb.checked = false; });
                if (sortSel) sortSel.selectedIndex = 0;
                order = cards.slice();
                order.forEach(c => grid.appendChild(c));
                page = 1; render();
            });
            sortSel?.addEventListener('change', () => {
                const v = sortSel.value;
                order = cards.slice();
                if (v === 'az') order.sort((a, b) => (a.dataset.name || '').localeCompare(b.dataset.name || ''));
                else if (v === 'newest') order.sort((a, b) => (b.dataset.date || '').localeCompare(a.dataset.date || ''));
                order.forEach(c => grid.appendChild(c));
                page = 1; render();
            });

            // Re-paginate when crossing the mobile breakpoint (rotate/resize).
            window.matchMedia('(max-width: 767px)').onchange = () => { page = 1; render(); };

            render();
        };
        setupCatalogue();
        document.addEventListener('astro:after-swap', setupCatalogue);
    </script>
</Layout>
