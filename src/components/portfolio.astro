---
import Layout from '../layouts/Layout.astro';
import { PORTFOLIO_PROJECTS, PORTFOLIO_CATEGORIES } from '../lib/defaults';

interface Props {
  pageData?: any;
  portfolios?: any[];
  categories?: any[];
  seo?: any;
}

const { pageData = null, portfolios = [], categories = [], seo } = Astro.props;

// Hero + CTA copy from ACF (page #29), with safe fallbacks to current content.
const heroEyebrow = pageData?.heroEyebrow || '';
const heroTitle = pageData?.heroTitle || 'Our Project Showcase';
const heroDescription = pageData?.heroDescription || 'A curated gallery of precision-engineered projects we have delivered for global brands and tactical units.';
const heroImage = pageData?.heroImage?.node?.sourceUrl || '';
const ctaTitle = pageData?.ctaTitle || 'Ready to start your project?';
const ctaText = pageData?.ctaText || 'Our design team is ready to translate your brand vision into a physical masterpiece. Get a free digital proof today.';
const ctaPrimaryLabel = pageData?.ctaPrimaryLabel || 'Request Free Design Proof';
const ctaPrimaryUrl = pageData?.ctaPrimaryUrl || '/contact';
const ctaSecondaryLabel = pageData?.ctaSecondaryLabel || 'Browse Products';
const ctaSecondaryUrl = pageData?.ctaSecondaryUrl || '/products';

const activePortfolios = portfolios.length > 0 ? portfolios : PORTFOLIO_PROJECTS;
// Build filter buttons from the categories that the displayed projects actually have,
// so the filter always matches the visible cards (no dead "empty category" buttons).
const presentMap = new Map<string, string>();
activePortfolios.forEach((p: any) => (p?.portfolioCategories?.nodes || []).forEach((c: any) => {
  if (c?.slug) presentMap.set(c.slug, c.name || c.slug);
}));
const filterCats = presentMap.size > 0
  ? [...presentMap].map(([slug, name]) => ({ slug, name }))
  : ((categories && categories.length > 0) ? categories : PORTFOLIO_CATEGORIES);
const catSlugs = (p: any) => (p?.portfolioCategories?.nodes || []).map((c: any) => c.slug).join(' ');
const catLabel = (p: any) => p?.portfolioCategories?.nodes?.[0]?.name || 'Custom';
const pImg = (p: any) => p?.featuredImage?.node?.sourceUrl || '';
---

<Layout title="Showcase | Hong Yu Manufacturing" seo={seo} description={heroDescription}>
    <main>
        <!-- Hero Section (image banner, left-aligned to match other pages) -->
        <section id="portfolio-hero" class="relative bg-primary py-xl flex items-center min-h-[260px] md:min-h-[504px] overflow-hidden">
            {heroImage && (
                <div class="absolute inset-0 pointer-events-none">
                    <img alt={heroTitle} fetchpriority="high" decoding="async" class="w-full h-full object-cover opacity-90" src={heroImage} />
                    <div class="absolute inset-0 bg-gradient-to-r from-primary via-primary/85 to-primary/40"></div>
                </div>
            )}
            <div class="relative z-10 max-w-container-max mx-auto px-gutter w-full">
                <div class="max-w-3xl">
                    {heroEyebrow && (
                        <div class="flex items-center gap-sm mb-sm">
                            <span class="font-label-bold text-label-bold text-cta-orange uppercase tracking-[0.2em] text-[12px]">{heroEyebrow}</span>
                        </div>
                    )}
                    <h1 class="font-display-lg text-white mb-md text-[22px] sm:text-[30px] lg:text-[44px] leading-[1.15] tracking-tight">{heroTitle}</h1>
                    <p class="font-body-lg text-body-lg text-white/80 max-w-2xl">{heroDescription}</p>
                </div>
            </div>
        </section>
        <!-- Filter bar (below hero — sticky, consistent with the Blog page) -->
        <section class="bg-white border-b border-outline-variant sticky top-[68px] z-40">
            <div class="max-w-container-max mx-auto px-gutter py-md flex items-center gap-md">
                <span class="font-label-bold text-on-surface whitespace-nowrap hidden sm:inline">FILTER:</span>
                <div class="flex items-center gap-sm overflow-x-auto hide-scrollbar" id="portfolio-filters">
                    <button class="shrink-0 whitespace-nowrap px-4 py-2 text-sm rounded-full border border-primary bg-primary text-white font-semibold transition-colors" data-filter="all">All Projects</button>
                    {filterCats.map((c: any) => (
                        <button class="shrink-0 whitespace-nowrap px-4 py-2 text-sm rounded-full border border-outline-variant hover:bg-surface-container-high font-semibold transition-colors" data-filter={c.slug}>{c.name}</button>
                    ))}
                </div>
            </div>
        </section>
        <!-- Portfolio Grid -->
        <section class="py-xl max-w-container-max mx-auto px-gutter">
            <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-gutter" id="portfolio-grid">
                {activePortfolios.map((item: any) => (
                    <a href={`/portfolio/${item.slug}`} class="portfolio-item card-lift group flex flex-col bg-white rounded-xl border border-outline-variant overflow-hidden hover:border-primary/40" data-category={catSlugs(item)}>
                        <div class="relative aspect-square overflow-hidden bg-surface-container">
                            {pImg(item) && (
                                <img loading="lazy" decoding="async" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" alt={item.title} src={pImg(item)} />
                            )}
                            <span class="absolute top-3 right-3 bg-white/90 backdrop-blur-sm px-2.5 py-1 rounded-full text-[10px] font-bold uppercase tracking-widest text-primary shadow-sm">{catLabel(item)}</span>
                        </div>
                        <div class="p-4 flex flex-col flex-grow">
                            <h3 class="font-headline-sm text-primary mb-sm group-hover:text-cta-orange transition-colors line-clamp-2">{item.title}</h3>
                            <div class="mt-auto flex items-center justify-between text-cta-orange font-bold text-xs uppercase tracking-wider group-hover:text-primary transition-colors">
                                <span>View Case Study</span>
                                <span class="material-symbols-outlined text-[18px] transition-transform group-hover:translate-x-1">arrow_forward</span>
                            </div>
                        </div>
                    </a>
                ))}
            </div>
            <div id="portfolio-empty" class="hidden text-center py-xl text-outline">No projects in this category yet.</div>
            <!-- Numbered pagination -->
            <nav id="portfolio-pagination" class="hidden flex flex-wrap items-center justify-center gap-xs pt-xl" aria-label="Portfolio pagination"></nav>
        </section>
        <!-- Footer CTA -->
        <section class="py-xl bg-primary text-white overflow-hidden relative">
            <div class="absolute inset-0 opacity-10 industrial-grid"></div>
            <div class="max-w-container-max mx-auto px-gutter relative z-10 text-center">
                <h2 class="font-headline-lg text-headline-lg mb-md">{ctaTitle}</h2>
                <p class="font-body-lg text-body-lg mb-lg max-w-xl mx-auto opacity-90">{ctaText}</p>
                <div class="flex flex-col sm:flex-row items-center justify-center gap-md">
                    {ctaPrimaryLabel && ctaPrimaryUrl && (
                        <a href={ctaPrimaryUrl} class="inline-block px-lg py-3 rounded bg-cta-orange text-white font-bold uppercase tracking-wider hover:brightness-110 shadow-lg transition-all text-center font-black">{ctaPrimaryLabel}</a>
                    )}
                    {ctaSecondaryLabel && ctaSecondaryUrl && ctaSecondaryUrl !== ctaPrimaryUrl && (
                        <a href={ctaSecondaryUrl} class="inline-block px-lg py-3 rounded border border-white/30 text-white font-bold uppercase tracking-wider hover:bg-white/10 transition-all text-center font-black">{ctaSecondaryLabel}</a>
                    )}
                </div>
            </div>
        </section>
    </main>

    <script>
        // 4 per page on mobile (≤767px), 12 on tablet/desktop.
        const perPage = () => window.matchMedia('(max-width: 767px)').matches ? 4 : 12;

        // Build a page-number list with ellipsis: 1 … 4 5 [6] 7 8 … 20
        const pageList = (current: number, total: number): (number | string)[] => {
            if (total <= 7) return Array.from({ length: total }, (_, i) => i + 1);
            const out: (number | string)[] = [1];
            const start = Math.max(2, current - 1);
            const end = Math.min(total - 1, current + 1);
            if (start > 2) out.push('…');
            for (let i = start; i <= end; i++) out.push(i);
            if (end < total - 1) out.push('…');
            out.push(total);
            return out;
        };

        const setupPortfolio = () => {
            const filterContainer = document.getElementById('portfolio-filters');
            const grid = document.getElementById('portfolio-grid');
            const empty = document.getElementById('portfolio-empty');
            const pager = document.getElementById('portfolio-pagination');
            if (!filterContainer || !grid || !pager) return;
            const buttons = Array.from(filterContainer.querySelectorAll('button')) as HTMLElement[];
            const items = Array.from(grid.querySelectorAll('.portfolio-item')) as HTMLElement[];

            let filter = 'all';
            let page = 1;

            const filtered = () => items.filter(item => {
                const cats = (item.getAttribute('data-category') || '').split(' ');
                return filter === 'all' || cats.includes(filter);
            });

            const render = () => {
                const PER_PAGE = perPage();
                const visible = filtered();
                const totalPages = Math.max(1, Math.ceil(visible.length / PER_PAGE));
                if (page > totalPages) page = totalPages;
                const startIdx = (page - 1) * PER_PAGE;
                const endIdx = startIdx + PER_PAGE;

                items.forEach(item => { item.style.display = 'none'; });
                visible.forEach((item, i) => {
                    item.style.display = (i >= startIdx && i < endIdx) ? 'flex' : 'none';
                });

                if (empty) empty.classList.toggle('hidden', visible.length !== 0);

                // Pagination controls
                pager.innerHTML = '';
                if (totalPages <= 1) { pager.classList.add('hidden'); return; }
                pager.classList.remove('hidden');

                const mkBtn = (label: string, target: number, opts: { disabled?: boolean, active?: boolean, dots?: boolean } = {}) => {
                    if (opts.dots) {
                        const span = document.createElement('span');
                        span.textContent = '…';
                        span.className = 'px-2 text-outline select-none';
                        pager.appendChild(span);
                        return;
                    }
                    const b = document.createElement('button');
                    b.textContent = label;
                    b.className = 'min-w-[38px] h-[38px] px-3 border text-sm font-bold transition-colors '
                        + (opts.active ? 'bg-primary text-white border-primary' : 'bg-white text-on-surface border-outline-variant hover:border-primary hover:text-primary')
                        + (opts.disabled ? ' opacity-40 cursor-not-allowed pointer-events-none' : '');
                    if (opts.disabled) b.disabled = true;
                    b.addEventListener('click', () => {
                        page = target;
                        render();
                        grid.scrollIntoView({ behavior: 'smooth', block: 'start' });
                    });
                    pager.appendChild(b);
                };

                mkBtn('‹', page - 1, { disabled: page === 1 });
                pageList(page, totalPages).forEach(p => {
                    if (typeof p === 'string') mkBtn('', 0, { dots: true });
                    else mkBtn(String(p), p, { active: p === page });
                });
                mkBtn('›', page + 1, { disabled: page === totalPages });
            };

            buttons.forEach(btn => btn.addEventListener('click', () => {
                buttons.forEach(b => { b.classList.remove('bg-primary', 'text-white', 'border-primary'); b.classList.add('border-outline-variant', 'hover:bg-surface-container-high'); });
                btn.classList.add('bg-primary', 'text-white', 'border-primary');
                btn.classList.remove('border-outline-variant', 'hover:bg-surface-container-high');
                filter = btn.getAttribute('data-filter') || 'all';
                page = 1;
                render();
            }));

            // Re-paginate when crossing the mobile breakpoint (rotate/resize).
            window.matchMedia('(max-width: 767px)').onchange = () => { page = 1; render(); };

            // Honour a ?cat=<slug> deep link (e.g. a portfolio breadcrumb) as the
            // initial filter, when a matching filter button exists.
            const requested = new URLSearchParams(window.location.search).get('cat');
            if (requested) {
                const match = buttons.find(b => b.getAttribute('data-filter') === requested);
                if (match) {
                    buttons.forEach(b => { b.classList.remove('bg-primary', 'text-white', 'border-primary'); b.classList.add('border-outline-variant', 'hover:bg-surface-container-high'); });
                    match.classList.add('bg-primary', 'text-white', 'border-primary');
                    match.classList.remove('border-outline-variant', 'hover:bg-surface-container-high');
                    filter = requested;
                }
            }

            render();
        };
        setupPortfolio();
        document.addEventListener('astro:after-swap', setupPortfolio);
    </script>
</Layout>
