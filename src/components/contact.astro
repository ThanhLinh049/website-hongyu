---
import Layout from '../layouts/Layout.astro';

interface Props {
  pageData?: any;
  seo?: any;
}

const { pageData, seo } = Astro.props;

const heroEyebrow = pageData?.heroEyebrow || '';
const heroTitle = pageData?.heroTitle || 'Contact Us for Custom Badges & Patches';
const heroDescription = pageData?.heroDescription || 'Partner with the industry leader in high-fidelity branding solutions. From fleet identification to luxury uniform branding, we deliver precision at scale.';
const heroBg = pageData?.heroBg?.node?.sourceUrl || '/demo/demo-02.webp';

const supportCards = pageData?.supportCards?.length ? pageData.supportCards : [
  { icon: 'hub', title: 'Sales Inquiry', description: 'Discuss large-scale procurement and contract pricing with our account team.', linkText: 'sales@hongyu.com', linkUrl: 'mailto:sales@hongyu.com' },
  { icon: 'brush', title: 'Design Studio', description: 'Technical assistance with artwork preparation and physical mockup requests.', linkText: 'design@hongyu.com', linkUrl: 'mailto:design@hongyu.com' },
  { icon: 'local_shipping', title: 'Order Tracking', description: 'Real-time production updates and shipping logistics for active orders.', linkText: 'Track Status Online', linkUrl: '#' },
  { icon: 'account_circle', title: 'Dealer Support', description: 'Dedicated priority assistance for our registered wholesale partners.', linkText: 'Portal Access', linkUrl: '#' }
];

// Quote form copy
const formTitle = pageData?.formTitle || 'Request a Manufacturing Quote';
const formIntro = pageData?.formIntro || 'Provide your technical specifications below. Our engineering team will review and provide a digital proof within 24 hours.';

// ACF select fields (support-card / social icons) arrive as arrays in GraphQL;
// normalise to a single value.
const one = (v: any) => (Array.isArray(v) ? v[0] : v);

// Editors often set an icon on some support cards but not others. Reserve the
// icon row for every card when at least one has an icon, so the titles stay on
// the same line; drop the row entirely when no card has one.
const anySupportIcon = supportCards.some((c: any) => one(c.icon));

// --- Quote form (fixed set of fields, hardcoded on purpose) ---
// The form is intentionally NOT editable in WP — it's defined here for
// reliability and a clean admin. Submissions still email via /api/contact
// (Resend). Each input's `name` is its label, which the email lists automatically.

// Backing Attachment depends on the selected Product Type (populated client-side).
// Challenge coins / Lapel pin have no defined backing options, so their select
// stays disabled with a "Not applicable" placeholder.
const backingOptionsByProductType: Record<string, string[]> = {
  'Flex badge': ['Velcro', '3M Adhesive', 'Iron On', 'Magnet', 'Sew On', 'Safety Pin'],
  'Embroidery patch': ['Velcro', '3M Adhesive', 'Iron On', 'Plastic', 'Sew On'],
  'PVC patch': ['Velcro', '3M Adhesive', 'Iron On', 'No Backing', 'Key Ring', 'Luggage Tag'],
  'Challenge coins': [],
  'Lapel pin': [],
};

const formFields = [
  { label: 'Product Type', type: 'select', width: 'half', required: false, placeholder: '', options: ['Flex badge', 'Embroidery patch', 'PVC patch', 'Challenge coins', 'Lapel pin'] },
  { label: 'Estimated Quantity', type: 'number', width: 'half', required: false, placeholder: 'Estimated Quantity', options: [] },
  { label: 'Dimensions (W x H)', type: 'text', width: 'half', required: false, placeholder: 'Dimensions (W x H)', options: [] },
  { label: 'Backing Attachment', type: 'select', width: 'half', required: false, placeholder: 'Select Product Type first', options: [] },
  { label: 'Finish Preference', type: 'text', width: 'half', required: false, placeholder: 'Finish Preference', options: [] },
  { label: 'Requested Lead Time', type: 'select', width: 'half', required: false, placeholder: '', options: ['Standard (15-20 days)', 'Expedited (10 days)', 'Rush (5-7 days)'] },
  { label: 'Full Name', type: 'text', width: 'half', required: true, placeholder: 'Full Name', options: [] },
  { label: 'Email Address', type: 'email', width: 'half', required: true, placeholder: 'Email Address', options: [] },
  { label: 'Company Name', type: 'text', width: 'half', required: false, placeholder: 'Company Name', options: [] },
  { label: 'Phone Number', type: 'tel', width: 'half', required: false, placeholder: 'Phone Number', options: [] },
  { label: 'Additional Project Notes', type: 'textarea', width: 'full', required: false, placeholder: 'Additional Project Notes', options: [] },
];
const submitButtonText = 'Submit Quote Request';
const successMessage = 'Thank you! Your quote request has been received. Our engineering team will reply with a digital proof within 24 hours.';
const uploadEnabled = true;
const uploadTitle = 'Click to upload or drag & drop artwork';
const uploadHint = 'SVG, AI, PDF, or high-res PNG (Max 4MB)';

// Direct contact sidebar
const hqTitle = pageData?.hqTitle || 'Manufacturing HQ';
const hqAddress = pageData?.hqAddress || '1280 Industrial Way, Suite 400\nManufacturing District\nChicago, IL 60601';
const phoneTitle = pageData?.phoneTitle || 'Support Hotline';
const phone = pageData?.phone || '+1 (800) 555-BADGE';
const hours = pageData?.hours || 'Mon-Fri: 8:00 AM - 6:00 PM CST';
const emailTitle = pageData?.emailTitle || 'General Mail';
const email = pageData?.email || 'info@hongyu.com';
const directionsUrl = pageData?.directionsUrl || '#';
const mapImage = pageData?.mapImage?.node?.sourceUrl || '/demo/demo-09.webp';

// Socials
const socialsTitle = pageData?.socialsTitle || 'Follow Our Process';
const socials = pageData?.socials?.length ? pageData.socials : [
  { icon: 'share', label: 'LinkedIn Professional', url: '#' },
  { icon: 'photo_camera', label: 'Instagram Portfolio', url: '#' }
];

const legalTitle = pageData?.legalTitle || 'Artwork Usage & Intellectual Property';
const legalText = pageData?.legalText || 'By submitting artwork to Hong Yu Manufacturing, the customer represents and warrants that they possess all necessary legal rights, permissions, and licenses to reproduce the provided trademarks, logos, and designs. Hong Yu assumes no liability for copyright or trademark infringement arising from the reproduction of customer-supplied artwork. We reserve the right to refuse orders containing imagery that violates our ethical manufacturing standards.';
---

<Layout title="Contact & Quote Request | Hong Yu" seo={seo} description={heroDescription}>
    <main>
        <!-- Hero Section -->
        <section class="relative bg-inverse-surface py-xl flex items-center min-h-[260px] md:min-h-[504px] overflow-hidden">
            <div class="absolute inset-0 pointer-events-none">
                <img alt="Industrial Backdrop" fetchpriority="high" decoding="async" class="w-full h-full object-cover opacity-90" src={heroBg}/>
                <div class="absolute inset-0 bg-gradient-to-r from-primary via-primary/80 to-transparent"></div>
            </div>
            <div class="relative z-10 max-w-container-max mx-auto px-gutter text-white w-full">
                <div class="max-w-3xl">
                    {heroEyebrow && (
                        <div class="flex items-center gap-sm mb-sm">
                            <span class="font-label-bold text-label-bold text-cta-orange uppercase tracking-[0.2em] text-[12px]">{heroEyebrow}</span>
                        </div>
                    )}
                    <h1 class="font-display-lg mb-4 text-[22px] sm:text-[30px] lg:text-[44px] leading-[1.15] tracking-tight [text-shadow:0_2px_14px_rgba(0,0,0,0.6)]">{heroTitle}</h1>
                    <p class="font-body-lg text-body-lg text-white/90 max-w-2xl [text-shadow:0_1px_10px_rgba(0,0,0,0.55)]">
                        {heroDescription}
                    </p>
                </div>
            </div>
        </section>
        <!-- Support Cards - Exactly 4 -->
        <section class="py-xl max-w-container-max mx-auto px-gutter">
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-md">
                {supportCards.map((card: any) => (
                    <div class="card-lift bg-white border border-outline-variant p-md hover:border-primary cursor-pointer group h-full flex flex-col items-start gap-sm">
                        {anySupportIcon && (
                            <span aria-hidden={!one(card.icon)} class="material-symbols-outlined text-primary text-4xl h-9 leading-none shrink-0">{one(card.icon)}</span>
                        )}
                        <h3 class="font-headline-sm text-headline-sm text-primary font-bold">{card.title}</h3>
                        <p class="font-body-sm text-body-sm text-on-surface-variant">{card.description}</p>
                        {/* mt-auto pins the link to the card's baseline without stretching the
                            paragraph above it, so links line up across cards of unequal copy. */}
                        <a href={card.linkUrl || '#'} class="mt-auto text-primary font-label-bold text-label-bold group-hover:translate-x-1 transition-transform border-b border-primary/20 pb-0.5">{card.linkText}</a>
                    </div>
                ))}
            </div>
        </section>
        <!-- Main Quote Form & Contact Details -->
        <section class="bg-surface-container-low py-xl">
            <div class="max-w-container-max mx-auto px-gutter grid grid-cols-1 lg:grid-cols-12 gap-md">
                <!-- Quote Form: Main Focus -->
                <div class="lg:col-span-8 bg-white shadow-sm border border-outline-variant p-lg">
                    <div class="mb-md">
                        <h2 class="font-headline-lg text-headline-lg text-primary font-bold mb-4">{formTitle}</h2>
                        <p class="font-body-md text-body-md text-on-surface-variant border-l-4 border-primary pl-4">{formIntro}</p>
                    </div>
                    <form class="space-y-md quote-form" action="/api/contact" method="POST" data-ajax-form data-success={successMessage}>
                        <!-- Honeypot spam filter (hidden from humans) -->
                        <input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" autocomplete="off" />
                        <!-- Fields below are fully editable in WP admin → Contact Page → Quote Form.
                             Half-width fields pair up on desktop; full-width fields span the whole row. -->
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-md">
                            {formFields.map((f: any) => (
                                <div class={f.width === 'full' ? 'md:col-span-2' : ''}>
                                    <label class="visually-hidden" for={`ff-${f.label}`}>{f.label}</label>
                                    {f.type === 'textarea' ? (
                                        <textarea id={`ff-${f.label}`} name={f.label} aria-label={f.label} required={f.required} placeholder={f.placeholder || f.label} rows="4" class="w-full border border-outline-variant p-sm font-body-md focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all"></textarea>
                                    ) : f.type === 'select' ? (
                                        <div class="relative">
                                            <select id={`ff-${f.label}`} name={f.label} aria-label={f.label} required={f.required} disabled={f.label === 'Backing Attachment'} class="w-full appearance-none border border-outline-variant p-sm pr-10 font-body-md bg-white focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all cursor-pointer disabled:bg-surface-container-low disabled:cursor-not-allowed">
                                                <option value="" selected disabled>{f.placeholder || f.label}</option>
                                                {f.options.map((o: string) => (<option>{o}</option>))}
                                            </select>
                                            <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-3 text-on-surface-variant">
                                                <span class="material-symbols-outlined text-[20px]" aria-hidden="true">expand_more</span>
                                            </div>
                                        </div>
                                    ) : (
                                        <input id={`ff-${f.label}`} name={f.label} aria-label={f.label} required={f.required} placeholder={f.placeholder || f.label} type={f.type} class="w-full border border-outline-variant p-sm font-body-md focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all" />
                                    )}
                                </div>
                            ))}
                        </div>
                        {uploadEnabled && (
                            <div class="py-md">
                                <div class="border-2 border-dashed border-outline-variant p-lg text-center bg-surface-container-lowest hover:border-primary hover:bg-primary-container/5 transition-all group cursor-pointer design-file-upload">
                                    <span class="material-symbols-outlined text-outline text-5xl mb-sm group-hover:text-primary transition-colors" aria-hidden="true">cloud_upload</span>
                                    <p class="font-headline-sm text-on-surface font-bold">{uploadTitle}</p>
                                    <p class="font-body-sm text-on-surface-variant mt-1">{uploadHint}</p>
                                    <input name="attachment" aria-label="Design files upload" class="hidden" id="artwork-upload" type="file"/>
                                </div>
                            </div>
                        )}
                        <div class="flex items-center gap-sm py-sm">
                            <input name="Agreed to Terms" value="Yes" required class="w-5 h-5 shrink-0 text-primary border-outline-variant focus:ring-primary rounded-sm" id="legal" type="checkbox"/>
                            <label class="font-body-sm text-on-surface font-medium" for="legal">I agree to the Terms of Service and Artwork Responsibility policy.</label>
                        </div>
                        <p data-form-status role="status" aria-live="polite" class="font-body-sm text-body-sm"></p>
                        <button class="w-full bg-primary text-white py-5 rounded font-label-bold text-label-bold uppercase tracking-[0.2em] hover:bg-primary/90 transition-all shadow-lg font-black text-lg disabled:opacity-60 disabled:cursor-not-allowed" type="submit">
                            {submitButtonText}
                        </button>
                    </form>
                </div>
                <!-- Contact Details Sidebar: Clean & Structured -->
                <div class="lg:col-span-4 space-y-md">
                    <div class="bg-white border border-outline-variant p-md shadow-sm">
                        <h3 class="font-headline-sm text-headline-sm text-primary font-bold mb-md uppercase tracking-tight">Direct Contact</h3>
                        <div class="space-y-md">
                            <div class="flex items-start gap-sm">
                                <span class="material-symbols-outlined text-primary bg-primary/10 p-2 rounded-full shrink-0">location_on</span>
                                <div>
                                    <p class="font-label-bold text-label-bold text-on-surface uppercase tracking-wider">{hqTitle}</p>
                                    <p class="font-body-md text-on-surface-variant leading-relaxed mt-1 whitespace-pre-line">{hqAddress}</p>
                                </div>
                            </div>
                            <div class="flex items-start gap-sm">
                                <span class="material-symbols-outlined text-primary bg-primary/10 p-2 rounded-full shrink-0">call</span>
                                <div>
                                    <p class="font-label-bold text-label-bold text-on-surface uppercase tracking-wider">{phoneTitle}</p>
                                    <p class="font-body-md text-on-surface-variant leading-relaxed mt-1">{phone}{hours && (<><br/>{hours}</>)}</p>
                                </div>
                            </div>
                            <div class="flex items-start gap-sm">
                                <span class="material-symbols-outlined text-primary bg-primary/10 p-2 rounded-full shrink-0">mail</span>
                                <div>
                                    <p class="font-label-bold text-label-bold text-on-surface uppercase tracking-wider">{emailTitle}</p>
                                    <p class="font-body-md text-on-surface-variant leading-relaxed mt-1">{email}</p>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- Map Block: Industrial Style -->
                    <div class="bg-white border border-outline-variant overflow-hidden shadow-sm">
                        <div class="h-64 relative">
                            <img alt="Office Map Location" loading="lazy" decoding="async" class="w-full h-full object-cover grayscale brightness-90 contrast-125" src={mapImage}/>
                            <div class="absolute inset-0 flex items-center justify-center">
                                <div class="bg-primary text-on-primary p-3 rounded-full shadow-2xl ring-4 ring-white">
                                    <span class="material-symbols-outlined text-3xl" style="font-variation-settings: 'FILL' 1;">location_on</span>
                                </div>
                            </div>
                        </div>
                        <a class="p-sm bg-surface hover:bg-surface-container-high flex justify-between items-center transition-colors" href={directionsUrl} target={directionsUrl !== '#' ? '_blank' : undefined} rel="noopener">
                            <span class="font-label-bold text-label-bold text-on-surface uppercase tracking-wider">Get Directions</span>
                            <span class="material-symbols-outlined text-primary">open_in_new</span>
                        </a>
                    </div>
                    <!-- Socials: Modern List -->
                    <div class="bg-surface border border-outline-variant p-md border-l-4 border-l-primary shadow-sm">
                        <h3 class="font-label-bold text-label-bold mb-sm uppercase tracking-widest text-primary">{socialsTitle}</h3>
                        <div class="flex flex-col gap-sm">
                            {socials.map((s: any) => (
                                <a class="flex items-center gap-sm text-on-surface hover:text-primary transition-colors py-2 border-b border-outline-variant/60 last:border-b-0" href={s.url || '#'} target={s.url && s.url !== '#' ? '_blank' : undefined} rel="noopener">
                                    <span class="material-symbols-outlined text-primary shrink-0">{one(s.icon)}</span>
                                    <span class="font-body-md">{s.label}</span>
                                </a>
                            ))}
                        </div>
                    </div>
                </div>
            </div>
        </section>
        <!-- Legal Note Section -->
        <section class="py-xl border-t border-outline-variant bg-white">
            <div class="max-w-container-max mx-auto px-gutter">
                <div class="bg-surface-container-low p-xl border-l-8 border-primary">
                    <div class="flex flex-col md:flex-row gap-md items-start">
                        <span class="material-symbols-outlined text-primary text-5xl">gavel</span>
                        <div>
                            <h4 class="font-headline-sm text-headline-sm text-primary mb-2 uppercase font-bold tracking-tight">{legalTitle}</h4>
                            <p class="font-body-md text-body-md text-on-surface-variant leading-relaxed">
                                {legalText}
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </main>
</Layout>

<script>
    import { initForms } from '../lib/forms';

    const setupContact = () => {
        initForms();
        const inputs = document.querySelectorAll('input, select, textarea');
        inputs.forEach(input => {
            input.addEventListener('focus', () => {
                input.closest('div')?.querySelector('label')?.classList.add('text-primary');
            });
            input.addEventListener('blur', () => {
                input.closest('div')?.querySelector('label')?.classList.remove('text-primary');
            });
        });

        // --- Dependent "Backing Attachment" options based on "Product Type" ---
        // Kept in sync with the `backingOptionsByProductType` map in the
        // frontmatter above. Update both places together if options change.
        const backingOptionsByProductType: Record<string, string[]> = {
            'Flex badge': ['Velcro', '3M Adhesive', 'Iron On', 'Magnet', 'Sew On', 'Safety Pin'],
            'Embroidery patch': ['Velcro', '3M Adhesive', 'Iron On', 'Plastic', 'Sew On'],
            'PVC patch': ['Velcro', '3M Adhesive', 'Iron On', 'No Backing', 'Key Ring', 'Luggage Tag'],
            'Challenge coins': [],
            'Lapel pin': [],
        };

        const productTypeSelect = document.getElementById('ff-Product Type') as HTMLSelectElement | null;
        const backingSelect = document.getElementById('ff-Backing Attachment') as HTMLSelectElement | null;

        const updateBackingOptions = () => {
            if (!productTypeSelect || !backingSelect) return;
            const selectedType = productTypeSelect.value;
            const options = backingOptionsByProductType[selectedType] || [];

            backingSelect.innerHTML = '';

            if (!selectedType) {
                const placeholder = document.createElement('option');
                placeholder.value = '';
                placeholder.textContent = 'Select Product Type first';
                placeholder.selected = true;
                placeholder.disabled = true;
                backingSelect.appendChild(placeholder);
                backingSelect.disabled = true;
                return;
            }

            if (options.length === 0) {
                const placeholder = document.createElement('option');
                placeholder.value = '';
                placeholder.textContent = 'Not applicable';
                placeholder.selected = true;
                placeholder.disabled = true;
                backingSelect.appendChild(placeholder);
                backingSelect.disabled = true;
                return;
            }

            const placeholder = document.createElement('option');
            placeholder.value = '';
            placeholder.textContent = 'Backing Attachment';
            placeholder.selected = true;
            placeholder.disabled = true;
            backingSelect.appendChild(placeholder);

            options.forEach((opt) => {
                const optionEl = document.createElement('option');
                optionEl.textContent = opt;
                backingSelect.appendChild(optionEl);
            });

            backingSelect.disabled = false;
        };

        if (productTypeSelect && backingSelect) {
            updateBackingOptions();
            productTypeSelect.addEventListener('change', updateBackingOptions);
        }

        const dropZone = document.querySelector('.design-file-upload') as HTMLElement | null;
        const fileInput = document.getElementById('artwork-upload') as HTMLInputElement | null;
        if (dropZone && fileInput) {
            dropZone.addEventListener('click', () => {
                fileInput.click();
            });
            dropZone.addEventListener('dragover', (e) => {
                e.preventDefault();
                dropZone.classList.add('border-primary', 'bg-primary-container/10');
            });
            dropZone.addEventListener('dragleave', () => {
                dropZone.classList.remove('border-primary', 'bg-primary-container/10');
            });
            dropZone.addEventListener('drop', (e) => {
                e.preventDefault();
                dropZone.classList.remove('border-primary', 'bg-primary-container/10');
                if (e.dataTransfer && e.dataTransfer.files.length) {
                    fileInput.files = e.dataTransfer.files;
                    // Trigger change event
                    fileInput.dispatchEvent(new Event('change'));
                }
            });
            fileInput.addEventListener('change', () => {
                if (fileInput.files && fileInput.files.length) {
                    const fileName = fileInput.files[0].name;
                    const pEl = dropZone.querySelector('p.font-headline-sm');
                    if (pEl) {
                        pEl.textContent = `Selected file: ${fileName}`;
                    }
                }
            });
        }
    };

    setupContact();
    document.addEventListener('astro:after-swap', setupContact);
</script>