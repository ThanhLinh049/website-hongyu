---
import Layout from '../layouts/Layout.astro';

interface Props {
  pageData?: any;
}

const { pageData } = Astro.props;

// 1. Hero fallbacks
const heroBadgeText = pageData?.heroBadgeText || 'Technical Excellence';
const heroTag = pageData?.heroTag || 'Services';
const heroTitle = pageData?.heroTitle || 'Precision Custom Manufacturing Services';
const heroDescription = pageData?.heroDescription || 'From initial blueprint to final assembly, we provide end-to-end industrial branding solutions. Our facility handles complex geometries, specialized materials, and high-volume rollouts with ISO-certified accuracy.';
const heroBgUrl = pageData?.heroBg?.node?.sourceUrl || 'https://lh3.googleusercontent.com/aida-public/AB6AXuD7OZ-HTsRSK5yFe8TwzVw0iOY1rFyn9KCxd5-7Pp1R8dhe-DNxysQH3jP-UOK1FZ_Ta7QRAC-eihNlPHcIWXNssB7WSjWdL_1ge5AMpZDUMkrr64s7X2aSSyzgM1uWIJ-4wGk-lj0xfcL3TDA6hzSOUhEov2yDfidAS6pK2GqDvNI8S3jKnaDX1A_G1FDfQ6C4Ffh17iwWyrESvwqUJmGos_SjPlPHz0ecmQYAkD76Al_2EoV2YAGagtCpistnjAUgMjtWrYkxlmV';
const heroCtaPrimaryText = pageData?.heroCtaPrimaryText || 'Start Your Project';
const heroCtaSecondaryText = pageData?.heroCtaSecondaryText || 'Download Technical Guide';

// 2. Capabilities fallbacks
const capabilitiesTitle = pageData?.capabilitiesTitle || 'Our Core Service Capabilities';
const capabilitiesDescription = pageData?.capabilitiesDescription || "We've refined our manufacturing ecosystem to offer six specialized pillars of service, ensuring every client receives tailored technical support.";
const capabilitiesList = pageData?.capabilitiesList || [
  { icon: 'draw', title: 'Design Proof', description: 'Accurate 2D and 3D digital renderings for engineering verification before production begins.' },
  { icon: 'brush', title: 'Artwork Support', description: 'Professional conversion of low-resolution concepts into production-ready technical vector files.' },
  { icon: 'precision_manufacturing', title: 'Custom Mfg', description: 'Proprietary tooling and molding for unique Flex-Badge, PVC, and multi-metal identifier shapes.' },
  { icon: 'psychology', title: 'Technical Consulting', description: 'Expert guidance on material selection, adhesive performance, and durability standards (UV, Chemical).' },
  { icon: 'verified_user', title: 'Quality Control', description: 'Multi-stage inspection protocols ensuring zero-defect delivery across large-scale manufacturing runs.' },
  { icon: 'autorenew', title: 'Simplified Reorder', description: 'Archived tooling and design specs for seamless, rapid replenishment and consistent brand fidelity.' }
];

// 3. Workflow steps
const workflowTitle = pageData?.workflowTitle || 'Technical Workflow';
const workflowSubtitle = pageData?.workflowSubtitle || 'A transparent timeline of our manufacturing lifecycle.';
const workflowSteps = pageData?.workflowSteps || [
  { stepNumber: 1, title: 'Consultation', description: 'Requirement gathering & material selection.' },
  { stepNumber: 2, title: 'Upload', description: 'Secure transmission of artwork & technical specs.' },
  { stepNumber: 3, title: 'Proof', description: 'Digital or physical sample rendering in 24 hours.' },
  { stepNumber: 4, title: 'Approval', description: 'Final sign-off on technical dimensions.' },
  { stepNumber: 5, title: 'Production', description: 'Automated manufacturing & QC audit.' },
  { stepNumber: 6, title: 'Delivery', description: 'Secure logistics and final handover.' }
];

// 4. QA Technical Panel
const qaTitle = pageData?.qaTitle || 'QA Technical Framework';
const qaDescription = pageData?.qaDescription || 'Our 7-point checklist ensures zero-defect delivery through rigorous automated and manual inspections.';
const qaList = pageData?.qaList || [
  { title: 'Color Chromatography', description: 'Matching to ±1% PMS variance using technical spectrometry.' },
  { title: 'Abrasion Resistance', description: 'Standardized 3000-cycle friction testing for industrial durability.' },
  { title: 'Adhesive Integrity', description: 'Peel-strength measurement aligned with 3M automotive standards.' }
];

const certTitle = pageData?.certTitle || 'Industrial Certification';
const certList = pageData?.certList || [
  { name: 'Quality Management', value: 'ISO 9001:2015' },
  { name: 'Material Safety', value: 'OEKO-TEX 100' },
  { name: 'Environmental Standard', value: 'ISO 14001' }
];
const certNote = pageData?.certNote || 'Facilities are audited bi-annually by third-party certification bodies to maintain global compliance standards.';

// 5. FAQ Accordion
const faqTitle = pageData?.faqTitle || 'Production FAQ';
const faqSubtitle = pageData?.faqSubtitle || 'Common questions regarding our custom manufacturing processes.';
const faqList = pageData?.faqList || [
  { question: 'What is the lead time for custom tooling?', answer: 'Custom tool and mold fabrication typically takes 7-10 business days. For urgent projects, we offer expedited tooling lanes that can reduce this window to 4 business days for a surcharge.' },
  { question: 'Do you provide physical pre-production samples?', answer: 'Yes. For orders over 1,000 units, we provide one physical pre-production sample for final sign-off. For smaller runs, we provide high-definition digital proofs or physical samples for a nominal setup fee.' },
  { question: 'What technical file formats are required?', answer: 'We prefer vector-based files: .AI (Adobe Illustrator), .EPS, or .SVG. If these are unavailable, we can work with high-resolution PDFs or .TIFF files. Our design team can assist with vector conversion if necessary.' }
];

// 6. Final CTA
const ctaTitle = pageData?.ctaTitle || 'Ready to manufacture your vision?';
const ctaDescription = pageData?.ctaDescription || 'Connect with an industrial branding specialist today for a technical feasibility audit and quote.';
const ctaPrimaryText = pageData?.ctaPrimaryText || 'Request Technical Quote';
const ctaSecondaryText = pageData?.ctaSecondaryText || 'Speak to an Engineer';
const ctaNote = pageData?.ctaNote || 'Typical technical response time: < 4 business hours.';
---

<Layout title="Custom Manufacturing Services | BadgeMaster">
    <main>
        <!-- Large Hero Section -->
        <section class="relative py-xl flex items-center min-h-[260px] md:min-h-[504px] bg-primary overflow-hidden">
            <div class="absolute inset-0">
                <img class="w-full h-full object-cover opacity-90" alt="Technical industrial background" src={heroBgUrl} />
                <div class="absolute inset-0 bg-gradient-to-r from-primary via-primary/80 to-transparent"></div>
            </div>
            <div class="relative z-10 w-full max-w-container-max mx-auto px-gutter">
                <div class="max-w-3xl">
                    <div class="flex items-center gap-sm text-white/70 mb-sm">
                        <span class="w-12 h-px bg-white/40"></span>
                        <span class="font-label-bold text-label-bold uppercase tracking-[0.2em] text-[12px]">{heroBadgeText}</span>
                    </div>
                    <h1 class="font-display-lg text-display-lg text-white mb-md leading-tight">
                        {heroTitle}
                    </h1>
                    <p class="font-body-lg text-body-lg text-white/80 mb-lg max-w-2xl">
                        {heroDescription}
                    </p>
                    <div class="flex flex-wrap gap-md">
                        <a href="/contact" class="bg-cta-orange text-white px-lg py-3 rounded-lg font-label-bold text-label-bold hover:brightness-110 transition-all shadow-lg text-center">
                            {heroCtaPrimaryText}
                        </a>
                        <a href="/contact" class="bg-white/10 backdrop-blur-md border border-white/20 text-white px-lg py-3 rounded-lg font-label-bold text-label-bold hover:bg-white/20 transition-all text-center">
                            {heroCtaSecondaryText}
                        </a>
                    </div>
                </div>
            </div>
        </section>

        <!-- Service Overview & 6 Key Cards -->
        <section class="py-xl bg-background">
            <div class="max-w-container-max mx-auto px-gutter">
                <div class="grid grid-cols-1 lg:grid-cols-12 gap-xl items-start mb-xl">
                    <div class="lg:col-span-4 lg:sticky lg:top-[96px]">
                        <h2 class="font-headline-lg text-headline-lg text-on-background mb-md">{capabilitiesTitle}</h2>
                        <p class="font-body-md text-on-surface-variant mb-md">{capabilitiesDescription}</p>
                        <div class="w-16 h-1 bg-primary"></div>
                    </div>
                    <div class="lg:col-span-8">
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-md">
                            {capabilitiesList.map((card) => (
                                <div class="glass-card p-md rounded-xl industrial-shadow flex flex-col group">
                                    <div class="w-12 h-12 bg-primary/10 text-primary rounded-lg flex items-center justify-center mb-md group-hover:bg-primary group-hover:text-white transition-colors">
                                        <span class="material-symbols-outlined">{card.icon}</span>
                                    </div>
                                    <h3 class="font-headline-sm text-headline-sm mb-sm">{card.title}</h3>
                                    <p class="font-body-md text-on-surface-variant">{card.description}</p>
                                </div>
                            ))}
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- 6-Step Horizontal Process Timeline -->
        <section class="py-xl bg-surface-container-low">
            <div class="max-w-container-max mx-auto px-gutter">
                <div class="text-center mb-xl">
                    <h2 class="font-headline-lg text-headline-lg">{workflowTitle}</h2>
                    <p class="text-on-surface-variant mt-xs">{workflowSubtitle}</p>
                </div>
                <div class="relative mt-xl overflow-x-auto pb-10">
                    <div class="flex justify-between min-w-[1000px] assembly-line px-10">
                        {workflowSteps.map((step, idx) => (
                            <div class="relative z-10 flex flex-col items-center text-center w-40 group">
                                <div class={`w-14 h-14 rounded-full flex items-center justify-center text-white font-bold mb-sm group-hover:scale-110 transition-transform shadow-lg ${idx < 4 ? 'bg-primary' : 'bg-secondary'}`}>
                                    {step.stepNumber}
                                </div>
                                <h4 class="font-label-bold text-label-bold mb-xs">{step.title}</h4>
                                <p class="text-[13px] text-on-surface-variant leading-tight">{step.description}</p>
                            </div>
                        ))}
                    </div>
                </div>
            </div>
        </section>

        <!-- Dark Blue QA Technical Panel -->
        <section class="py-xl bg-primary">
            <div class="max-w-container-max mx-auto px-gutter">
                <div class="bg-on-primary-fixed p-xl md:p-24 rounded-2xl border border-white/10 relative overflow-hidden">
                    <div class="absolute top-0 right-0 p-xl opacity-5 pointer-events-none">
                        <span class="material-symbols-outlined text-[20rem]">verified</span>
                    </div>
                    <div class="relative z-10 grid grid-cols-1 lg:grid-cols-2 gap-xl items-center">
                        <div>
                            <h2 class="font-display-lg text-display-lg text-white mb-md">{qaTitle}</h2>
                            <p class="text-secondary-container font-body-lg mb-xl max-w-lg">{qaDescription}</p>
                            <div class="space-y-md">
                                {qaList.map((item) => (
                                    <div class="flex items-start gap-md">
                                        <span class="material-symbols-outlined text-secondary-container mt-1">check_circle</span>
                                        <div>
                                            <h4 class="text-white font-label-bold">{item.title}</h4>
                                            <p class="text-surface-variant text-body-sm">{item.description}</p>
                                        </div>
                                    </div>
                                ))}
                            </div>
                        </div>
                        <div class="bg-white/5 backdrop-blur-sm border border-white/10 p-xl rounded-xl">
                            <h3 class="text-white font-headline-md mb-md">{certTitle}</h3>
                            <div class="space-y-sm mb-xl">
                                {certList.map((item) => (
                                    <div class="flex justify-between text-body-sm py-2 border-b border-white/10">
                                        <span class="text-secondary-container">{item.name}</span>
                                        <span class="text-white font-bold">{item.value}</span>
                                    </div>
                                ))}
                            </div>
                            <p class="text-surface-variant text-[12px] italic">{certNote}</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Service FAQ Accordion -->
        <section class="py-xl bg-background">
            <div class="max-w-container-max mx-auto px-gutter">
                <div class="text-center mb-xl">
                    <h2 class="font-headline-lg text-headline-lg">{faqTitle}</h2>
                    <p class="text-on-surface-variant mt-xs">{faqSubtitle}</p>
                </div>
                <div class="space-y-md">
                    {faqList.map((item) => (
                        <div class="bg-white border border-outline-variant rounded-xl overflow-hidden shadow-sm">
                            <button class="faq-toggle flex items-center justify-between w-full text-left py-sm px-md group">
                                <span class="font-headline-sm text-headline-sm text-primary">{item.question}</span>
                                <span class="material-symbols-outlined text-outline group-hover:text-primary transition-transform duration-300">expand_more</span>
                            </button>
                            <div class="faq-content max-h-0 overflow-hidden transition-all duration-300 ease-in-out">
                                <div class="px-md pb-sm font-body-md text-on-surface-variant border-t border-outline-variant/30 pt-sm leading-relaxed">
                                    {item.answer}
                                </div>
                            </div>
                        </div>
                    ))}
                </div>
            </div>
        </section>

        <!-- Final CTA -->
        <section class="py-xl bg-primary text-white">
            <div class="max-w-container-max mx-auto px-gutter text-center">
                <h2 class="font-display-lg text-display-lg mb-md">{ctaTitle}</h2>
                <p class="font-body-lg text-white/80 max-w-2xl mx-auto mb-xl">{ctaDescription}</p>
                <div class="flex flex-col md:flex-row gap-md justify-center items-center">
                    <a href="/contact" class="md:w-auto bg-cta-orange text-white px-lg py-3 rounded-lg font-label-bold text-label-bold hover:brightness-110 transition-all shadow-lg text-center">
                        {ctaPrimaryText}
                    </a>
                    <a href="/contact" class="md:w-auto border border-white/30 bg-white/5 backdrop-blur-sm text-white px-lg py-3 rounded-lg font-label-bold text-label-bold hover:bg-white/10 transition-all text-center">
                        {ctaSecondaryText}
                    </a>
                </div>
                <p class="mt-md text-body-sm text-white/60">{ctaNote}</p>
            </div>
        </section>
    </main>
</Layout>

<script>
    const setupFaq = () => {
        document.querySelectorAll('.faq-toggle').forEach(btn => {
            // Remove existing listener to avoid double binding if re-run
            const clone = btn.cloneNode(true);
            btn.parentNode?.replaceChild(clone, btn);
        });
        
        document.querySelectorAll('.faq-toggle').forEach(btn => {
            btn.addEventListener('click', () => {
                const content = btn.nextElementSibling as HTMLElement | null;
                const icon = btn.querySelector('.material-symbols-outlined') as HTMLElement | null;

                if (content && icon) {
                    if (content.style.maxHeight) {
                        content.style.maxHeight = '';
                        icon.style.transform = 'rotate(0deg)';
                    } else {
                        content.style.maxHeight = content.scrollHeight + "px";
                        icon.style.transform = 'rotate(180deg)';
                    }
                }
            });
        });

        // Initialize first FAQ as open
        const firstFaq = document.querySelector('.faq-toggle') as HTMLElement | null;
        if (firstFaq) {
            const content = firstFaq.nextElementSibling as HTMLElement | null;
            const icon = firstFaq.querySelector('.material-symbols-outlined') as HTMLElement | null;
            if (content && icon) {
                content.style.maxHeight = content.scrollHeight + "px";
                icon.style.transform = 'rotate(180deg)';
            }
        }
    };

    setupFaq();
    document.addEventListener('astro:after-swap', setupFaq);
</script>
