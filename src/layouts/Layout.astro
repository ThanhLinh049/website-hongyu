---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { wpQuery } from '../lib/api';
import { buildSeo } from '../lib/seo';

interface Props {
  title: string;
  /** Home page only: render a transparent header that overlays the hero. */
  heroHeader?: boolean;
  /** Rank Math SEO object (from `${SEO_FRAGMENT}` in the page query). */
  seo?: any;
  /** SEO fallbacks when no Rank Math `seo` is passed. */
  description?: string;
  ogTitle?: string;
  ogImage?: string;
}

const { title, heroHeader = false, seo, description, ogTitle, ogImage } = Astro.props;

const pathname = new URL(Astro.request.url).pathname;
const cleanPath = pathname.replace(/\/$/, "");

// Build the full, frontend-correct SEO meta set (Rank Math when present, else
// the title/description/ogImage fallbacks). origin: configured `site` on deploy,
// else the current request origin.
const siteOrigin = Astro.site?.toString().replace(/\/$/, "") || new URL(Astro.request.url).origin;
const meta = buildSeo({
  seo,
  url: siteOrigin + pathname,
  origin: siteOrigin,
  fallbackTitle: title,
  fallbackDescription: description,
  fallbackImage: ogImage,
});

// 1. Define default site settings (fallbacks)
const defaultSettings: Record<string, any> = {
  siteLogoText: "Hong Yu",
  siteLogoImage: { node: { sourceUrl: "/logo.webp" } },
  siteFavicon: null,
  siteTagline: "",
  headerNavigation: [
    { label: "Home", url: "/" },
    { label: "Products", url: "/products" },
    { label: "Portfolio", url: "/portfolio" },
    { label: "Services", url: "/services" },
    { label: "Blog", url: "/blog" },
    { label: "Contact", url: "/contact" }
  ],
  headerCtaLabel: "Request Free Quote",
  headerCtaUrl: "/contact",
  contactPhone: "+1 (800) 555-BADGE",
  contactEmail: "info@hongyu.com",
  contactAddress: "1280 Industrial Way, Suite 400\nManufacturing District\nChicago, IL 60601",
  socialFacebook: "#",
  socialLinkedin: "#",
  socialInstagram: "#",
  siteCopyright: "© 2024 Hong Yu Manufacturing. All rights reserved.",
  footerDescription: "Global leader in industrial custom badge manufacturing for corporate, military, and lifestyle brands.",
  footerTagline: "Industrial Precision Guaranteed.",
  footerColumns: null
};

let siteSettings = defaultSettings;
let productCategories: Array<{ name: string, slug: string }> = [];

// 2. Fetch from WordPress WPGraphQL
try {
  const data = await wpQuery({
    query: `
      query GetGlobalSettings {
        productCategories(first: 50, where: { hideEmpty: false }) {
          nodes { name slug }
        }
        page(id: "site-settings", idType: URI) {
          siteSettingsPage {
            siteLogoText
            siteLogoImage {
              node {
                sourceUrl
              }
            }
            siteFavicon {
              node {
                sourceUrl
              }
            }
            headerNavigation {
              label
              url
            }
            headerCtaLabel
            headerCtaUrl
            footerColumn1 {
              logo {
                node {
                  sourceUrl
                }
              }
              companyName
              description
              phone
              email
              address
              socialLinks {
                platform
                url
              }
            }
            footerColumns {
              title
              links {
                label
                url
              }
            }
            absoluteFooter {
              copyright
              credit
            }
          }
        }
      }
    `
  });
  if (data?.productCategories?.nodes) {
    productCategories = data.productCategories.nodes;
  }
  if (data?.page?.siteSettingsPage) {
    // Keep fallbacks if subfields are empty
    siteSettings = {
      ...defaultSettings,
      ...Object.fromEntries(
        Object.entries(data.page.siteSettingsPage).filter(([_, v]) => v !== null && v !== undefined && v !== "")
      )
    };
  }
} catch (e) {
  console.warn("Failed to fetch global settings from WordPress. Using static fallback data.", e);
}

// Favicon: WP "Site Favicon" when set, else the bundled logo (exists in public/).
// Derive the MIME type from the extension so the <link> type is always correct.
const faviconUrl = siteSettings.siteFavicon?.node?.sourceUrl || "/logo.webp";
const faviconType = faviconUrl.endsWith(".svg") ? "image/svg+xml"
  : faviconUrl.endsWith(".webp") ? "image/webp"
  : faviconUrl.endsWith(".ico") ? "image/x-icon"
  : faviconUrl.endsWith(".jpg") || faviconUrl.endsWith(".jpeg") ? "image/jpeg"
  : "image/png";
---

<!DOCTYPE html>
<html class="light scroll-smooth" lang="en">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>{meta.title || title}</title>
    {meta.description && <meta name="description" content={meta.description} />}
    <meta name="robots" content={meta.robots} />
    {meta.keywords && <meta name="keywords" content={meta.keywords} />}
    <link rel="canonical" href={meta.canonical} />
    <!-- Open Graph -->
    <meta property="og:type" content={meta.ogType} />
    <meta property="og:title" content={meta.ogTitle || ogTitle || title} />
    {meta.ogDescription && <meta property="og:description" content={meta.ogDescription} />}
    <meta property="og:url" content={meta.ogUrl} />
    {meta.ogImage && <meta property="og:image" content={meta.ogImage} />}
    <meta property="og:site_name" content={siteSettings.siteLogoText} />
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={meta.ogTitle || title} />
    {meta.ogDescription && <meta name="twitter:description" content={meta.ogDescription} />}
    {meta.ogImage && <meta name="twitter:image" content={meta.ogImage} />}
    <!-- JSON-LD structured data (Rank Math) -->
    {meta.jsonLd && <Fragment set:html={meta.jsonLd} />}
    <link rel="icon" type={faviconType} href={faviconUrl} />
    <!-- Fonts (only the weights actually used: Inter 400/500/600/700/900, Roboto 400/500/700) -->
    <link href="https://fonts.googleapis.com" rel="preconnect" />
    <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect" />
    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;900&family=Roboto:wght@400;500;700&display=swap"
        rel="stylesheet" />
    <!-- Icons: subset to only the icons the site uses (via icon_names) — ~23KB vs ~313KB
         for the full font. IMPORTANT: if you use a NEW Material Symbols icon anywhere
         (including icon fields in WP admin), add its name to the icon_names list below,
         otherwise it will not render. display=block avoids ligature text flashing. -->
    <link
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&icon_names=account_circle,add,arrow_back,arrow_forward,article,autorenew,bolt,brush,build,business,calendar_today,call,category,chat,check_circle,checklist,chevron_left,chevron_right,close,cloud_upload,colorize,construction,dashboard,delete,design_services,diamond,download,draw,eco,edit,email,emoji_events,engineering,event,expand_more,fact_check,factory,favorite,gavel,grid_view,group,handyman,high_quality,home,hub,image,image_not_supported,info,insights,inventory,inventory_2,label,layers,lightbulb,list,local_fire_department,local_shipping,location_on,mail,menu,military_tech,open_in_new,palette,payments,person,phone,photo_camera,precision_manufacturing,print,psychology,public,recycling,rocket_launch,schedule,science,search,search_off,sell,settings,share,shield,shopping_cart,speed,star,store,straighten,support_agent,task_alt,texture,thumb_up,trending_up,verified,verified_user,visibility,warehouse,warning,water_drop,wb_sunny,workspace_premium&display=block"
        rel="stylesheet" />
</head>
<body class="font-body-md text-body-md overflow-x-clip">
    <!-- Header Component with Dynamic Props -->
    <Header
        navigation={siteSettings.headerNavigation}
        productCategories={productCategories}
        logoText={siteSettings.siteLogoText}
        logoImage={siteSettings.siteLogoImage}
        ctaLabel={siteSettings.headerCtaLabel}
        ctaUrl={siteSettings.headerCtaUrl}
        transparent={heroHeader}
    />

    <!-- Mobile Menu Drawer (Overlay) -->
    <div id="mobile-menu-drawer"
        class="hidden fixed inset-0 z-50 bg-black/50 backdrop-blur-sm transition-opacity duration-300">
        <div class="fixed top-0 right-0 bottom-0 w-[88vw] max-w-[360px] bg-surface flex flex-col shadow-2xl transition-transform duration-300 translate-x-full"
            id="mobile-menu-content">
            <!-- Close button — right aligned; no logo text, no divider -->
            <div class="flex justify-end px-4 pt-4 pb-2 shrink-0">
                <button id="mobile-menu-close" aria-label="Close menu"
                    class="w-10 h-10 flex items-center justify-center rounded-lg bg-[#f0eded] text-on-surface hover:text-primary focus:outline-none transition-colors">
                    <span class="material-symbols-outlined text-[24px]" aria-hidden="true">close</span>
                </button>
            </div>
            <!-- Navigation (scrolls if the list is long) -->
            <nav class="flex-1 overflow-y-auto px-3 pb-4 flex flex-col gap-1">
                {siteSettings.headerNavigation.map((item: any) => {
                    const isCurrent = (item.url === "/" && cleanPath === "") || (item.url !== "/" && cleanPath === item.url);
                    const isProducts = item.url === "/products" && productCategories.length > 0;
                    return (
                        <div>
                            <a
                                class={isCurrent
                                    ? "flex items-center px-4 py-3 rounded-xl font-semibold text-primary bg-[#d7e2ff]"
                                    : "flex items-center px-4 py-3 rounded-xl font-medium text-on-surface-variant hover:bg-surface-container-high hover:text-primary transition-colors"}
                                href={item.url}
                            >
                                {item.label}
                            </a>
                            {isProducts && (
                                <div class="mt-1 mb-1 ml-5 pl-4 border-l-2 border-outline-variant flex flex-col gap-0.5">
                                    {productCategories.map((c: any) => (
                                        <a class="px-3 py-2 rounded-lg text-sm text-on-surface-variant hover:text-primary hover:bg-surface-container-high transition-colors" href={`/products/${c.slug}`}>{c.name}</a>
                                    ))}
                                </div>
                            )}
                        </div>
                    );
                })}
            </nav>
            <!-- Bottom CTA pinned to the base -->
            <div class="shrink-0 px-4 pt-3 pb-5 border-t border-outline-variant">
                <a href="/contact"
                    class="block w-full bg-cta-orange text-white text-center py-3 rounded font-label-bold text-label-bold hover:brightness-110 transition-all">Request Free Quote</a>
            </div>
        </div>
    </div>

    <!-- Main Slot Content -->
    <slot />

    <!-- Footer Component with Dynamic Props -->
    <Footer
        footerColumn1={siteSettings.footerColumn1}
        footerColumns={siteSettings.footerColumns}
        absoluteFooter={siteSettings.absoluteFooter}
    />

    <script>
        // Setup mobile menu interactions
        const setupMobileMenu = () => {
            const menuBtn = document.getElementById('mobile-menu-btn');
            const menuClose = document.getElementById('mobile-menu-close');
            const drawer = document.getElementById('mobile-menu-drawer');
            const drawerContent = document.getElementById('mobile-menu-content');

            if (menuBtn && drawer && drawerContent) {
                menuBtn.addEventListener('click', () => {
                    drawer.classList.remove('hidden');
                    setTimeout(() => {
                        drawerContent.classList.remove('translate-x-full');
                    }, 10);
                });
            }

            if (menuClose && drawer && drawerContent) {
                menuClose.addEventListener('click', () => {
                    drawerContent.classList.add('translate-x-full');
                    setTimeout(() => {
                        drawer.classList.add('hidden');
                    }, 300);
                });

                drawer.addEventListener('click', (e) => {
                    if (e.target === drawer) {
                        drawerContent.classList.add('translate-x-full');
                        setTimeout(() => {
                            drawer.classList.add('hidden');
                        }, 300);
                    }
                });
            }
        };

        // Initialize script on startup
        setupMobileMenu();

        // Re-run on Astro view transitions if they are used, or keep simple
        document.addEventListener('astro:after-swap', setupMobileMenu);
    </script>
</body>
</html>
