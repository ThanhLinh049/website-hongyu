---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { wpQuery } from '../lib/api';

interface Props {
  title: string;
  /** Home page only: render a transparent header that overlays the hero. */
  heroHeader?: boolean;
  /** SEO (from Rank Math on detail pages) */
  description?: string;
  ogTitle?: string;
  ogImage?: string;
}

const { title, heroHeader = false, description, ogTitle, ogImage } = Astro.props;

const pathname = new URL(Astro.request.url).pathname;
const cleanPath = pathname.replace(/\/$/, "");

// 1. Define default site settings (fallbacks)
const defaultSettings: Record<string, any> = {
  siteLogoText: "BadgeMaster",
  siteLogoImage: null,
  siteFavicon: null,
  siteTagline: "",
  headerNavigation: [
    { label: "Home", url: "/" },
    { label: "Products", url: "/products" },
    { label: "Portfolio", url: "/portfolio" },
    { label: "Services", url: "/services" },
    { label: "Blog", url: "/blog" },
    { label: "Contact", url: "/contact" }
  ],
  headerCtaLabel: "Request Free Quote",
  headerCtaUrl: "/contact",
  contactPhone: "+1 (800) 555-BADGE",
  contactEmail: "info@badgemaster.com",
  contactAddress: "1280 Industrial Way, Suite 400\nManufacturing District\nChicago, IL 60601",
  socialFacebook: "#",
  socialLinkedin: "#",
  socialInstagram: "#",
  siteCopyright: "© 2024 BadgeMaster Manufacturing. All rights reserved.",
  footerDescription: "Global leader in industrial custom badge manufacturing for corporate, military, and lifestyle brands.",
  footerTagline: "Industrial Precision Guaranteed.",
  footerColumns: null
};

let siteSettings = defaultSettings;
let productCategories: Array<{ name: string, slug: string }> = [];

// 2. Fetch from WordPress WPGraphQL
try {
  const data = await wpQuery({
    query: `
      query GetGlobalSettings {
        productCategories(first: 50, where: { hideEmpty: false }) {
          nodes { name slug }
        }
        page(id: "site-settings", idType: URI) {
          siteSettingsPage {
            siteLogoText
            siteLogoImage {
              node {
                sourceUrl
              }
            }
            siteFavicon {
              node {
                sourceUrl
              }
            }
            headerNavigation {
              label
              url
            }
            headerCtaLabel
            headerCtaUrl
            footerColumn1 {
              logo {
                node {
                  sourceUrl
                }
              }
              companyName
              description
              phone
              email
              facebook
              linkedin
              instagram
            }
            footerColumns {
              title
              links {
                label
                url
              }
            }
            absoluteFooter {
              copyright
              credit
            }
          }
        }
      }
    `
  });
  if (data?.productCategories?.nodes) {
    productCategories = data.productCategories.nodes;
  }
  if (data?.page?.siteSettingsPage) {
    // Keep fallbacks if subfields are empty
    siteSettings = {
      ...defaultSettings,
      ...Object.fromEntries(
        Object.entries(data.page.siteSettingsPage).filter(([_, v]) => v !== null && v !== undefined && v !== "")
      )
    };
  }
} catch (e) {
  console.warn("Failed to fetch global settings from WordPress. Using static fallback data.", e);
}

const faviconUrl = siteSettings.siteFavicon?.node?.sourceUrl || "/favicon.ico";
---

<!DOCTYPE html>
<html class="light scroll-smooth" lang="en">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={ogTitle || title} />
    {description && <meta property="og:description" content={description} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/png" href={faviconUrl} />
    <!-- Fonts -->
    <link href="https://fonts.googleapis.com" rel="preconnect" />
    <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect" />
    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Roboto:wght@300;400;500;700&display=swap"
        rel="stylesheet" />
    <!-- Icons (display=block so icon ligature names never flash as raw text while loading) -->
    <link
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=block"
        rel="stylesheet" />
</head>
<body class="font-body-md text-body-md overflow-x-clip">
    <!-- Header Component with Dynamic Props -->
    <Header
        navigation={siteSettings.headerNavigation}
        productCategories={productCategories}
        logoText={siteSettings.siteLogoText}
        logoImage={siteSettings.siteLogoImage}
        ctaLabel={siteSettings.headerCtaLabel}
        ctaUrl={siteSettings.headerCtaUrl}
        transparent={heroHeader}
    />

    <!-- Mobile Menu Drawer (Overlay) -->
    <div id="mobile-menu-drawer"
        class="hidden fixed inset-0 z-50 bg-black/50 backdrop-blur-sm transition-opacity duration-300">
        <div class="fixed top-0 right-0 bottom-0 w-4/5 max-w-sm bg-surface p-6 flex flex-col gap-6 shadow-2xl transition-transform duration-300 translate-x-full"
            id="mobile-menu-content">
            <div class="flex justify-between items-center pb-4 border-b border-outline-variant">
                <span class="font-headline-md text-headline-md font-bold text-primary">{siteSettings.siteLogoText}</span>
                <button id="mobile-menu-close"
                    class="text-on-surface hover:text-primary focus:outline-none flex items-center justify-center p-1">
                    <span class="material-symbols-outlined text-[24px]">close</span>
                </button>
            </div>
            <nav class="flex flex-col gap-4 text-body-lg font-medium text-on-surface-variant">
                {siteSettings.headerNavigation.map((item: any) => {
                    const isCurrent = (item.url === "/" && cleanPath === "") || (item.url !== "/" && cleanPath === item.url);
                    const isProducts = item.url === "/products" && productCategories.length > 0;
                    return (
                        <div>
                            <a
                                class={isCurrent ? "text-primary font-bold py-2 block" : "hover:text-primary py-2 block"}
                                href={item.url}
                            >
                                {item.label}
                            </a>
                            {isProducts && (
                                <div class="flex flex-col gap-2 pl-4 mt-1 border-l border-outline-variant text-body-md">
                                    {productCategories.map((c: any) => (
                                        <a class="hover:text-primary py-1" href={`/products/${c.slug}`}>{c.name}</a>
                                    ))}
                                </div>
                            )}
                        </div>
                    );
                })}
            </nav>
            <div class="mt-auto flex flex-col gap-3 pt-6 border-t border-outline-variant">
                <button onclick="alert('Dealer portal coming soon!')"
                    class="w-full bg-surface-container border border-outline py-3 font-label-bold text-label-bold hover:bg-surface-container-high transition-colors">Dealer
                    Login</button>
                <a href="/contact"
                    class="w-full bg-cta-orange text-white text-center py-3 font-label-bold text-label-bold hover:opacity-90 transition-opacity">Request
                    Free Quote</a>
            </div>
        </div>
    </div>

    <!-- Main Slot Content -->
    <slot />

    <!-- Footer Component with Dynamic Props -->
    <Footer
        footerColumn1={siteSettings.footerColumn1}
        footerColumns={siteSettings.footerColumns}
        absoluteFooter={siteSettings.absoluteFooter}
    />

    <script>
        // Setup mobile menu interactions
        const setupMobileMenu = () => {
            const menuBtn = document.getElementById('mobile-menu-btn');
            const menuClose = document.getElementById('mobile-menu-close');
            const drawer = document.getElementById('mobile-menu-drawer');
            const drawerContent = document.getElementById('mobile-menu-content');

            if (menuBtn && drawer && drawerContent) {
                menuBtn.addEventListener('click', () => {
                    drawer.classList.remove('hidden');
                    setTimeout(() => {
                        drawerContent.classList.remove('translate-x-full');
                    }, 10);
                });
            }

            if (menuClose && drawer && drawerContent) {
                menuClose.addEventListener('click', () => {
                    drawerContent.classList.add('translate-x-full');
                    setTimeout(() => {
                        drawer.classList.add('hidden');
                    }, 300);
                });

                drawer.addEventListener('click', (e) => {
                    if (e.target === drawer) {
                        drawerContent.classList.add('translate-x-full');
                        setTimeout(() => {
                            drawer.classList.add('hidden');
                        }, 300);
                    }
                });
            }
        };

        // Initialize script on startup
        setupMobileMenu();

        // Re-run on Astro view transitions if they are used, or keep simple
        document.addEventListener('astro:after-swap', setupMobileMenu);
    </script>
</body>
</html>
