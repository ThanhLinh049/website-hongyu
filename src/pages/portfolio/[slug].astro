---
// Static: every portfolio project is prerendered at build (deploy). New/edited
// projects go live only on the next Deploy. See getStaticPaths below.
import Layout from '../../layouts/Layout.astro';
import { wpQuery, fetchAllNodes, rewriteHtmlMedia } from '../../lib/api';
import { SEO_FRAGMENT } from '../../lib/seo';

export async function getStaticPaths() {
  const nodes = await fetchAllNodes('portfolios', 'slug');
  return nodes.filter((n: any) => n?.slug).map((n: any) => ({ params: { slug: n.slug } }));
}

const { slug } = Astro.params;

let project: any = null;
let all: any[] = [];
try {
  const data = await wpQuery({
    query: `
      query GetProject($slug: ID!) {
        portfolio(id: $slug, idType: SLUG) {
          title
          slug
          content
          featuredImage { node { sourceUrl } }
          portfolioFields { specs { label value } }
          portfolioCategories { nodes { name slug } }
          ${SEO_FRAGMENT}
        }
        portfolios(first: 200) {
          nodes {
            title slug
            featuredImage { node { sourceUrl } }
            portfolioCategories { nodes { name slug } }
          }
        }
      }
    `,
    variables: { slug }
  });
  project = data?.portfolio || null;
  all = data?.portfolios?.nodes || [];
} catch (e) {
  console.warn('Failed to fetch project', slug, e);
}

// Fallback demo project — keeps the page design when the portfolio can't be
// loaded from WordPress (e.g. no backend), instead of a bare "not found".
const defaultProject = {
  title: 'Metro Police Emblem',
  slug: slug || 'sample-project',
  content: '<p>This is a sample case study, shown when the portfolio is unavailable so the page layout stays intact.</p>',
  featuredImage: null,
  portfolioFields: {
    specs: [
      { label: 'Material', value: 'Die-struck metal' },
      { label: 'Finish', value: 'Antique silver' },
      { label: 'Size', value: '3 inches' },
    ],
  },
  portfolioCategories: { nodes: [{ name: 'Law Enforcement', slug: 'law-enforcement' }] },
  seo: null,
};
project = project || defaultProject;

const pf = project?.portfolioFields || {};
const mainImage = project?.featuredImage?.node?.sourceUrl || '';
const cat = project?.portfolioCategories?.nodes?.[0];
const related = project
  ? (all || []).filter((p: any) => p.slug !== project.slug && (p.portfolioCategories?.nodes || []).some((c: any) => c.slug === cat?.slug)).slice(0, 6)
  : [];

// Project Details rows from the repeater (hide rows with empty value)
const specs = (pf.specs || []).filter((s: any) => s.value && String(s.value).trim() !== '');

// Horizontal "Project Details" band: Category (from taxonomy) + the spec rows.
const detailItems = [
  ...(cat ? [{ label: 'Category', value: cat.name }] : []),
  ...specs
];

const seoTitle = project?.seo?.title || (project ? `${project.title} | Showcase` : 'Project not found');
const seoDesc = project?.seo?.description || (project ? `${project.title} — custom manufacturing case study.` : '');
const seoImage = project?.seo?.openGraph?.image?.url || mainImage;
const relImg = (p: any) => p?.featuredImage?.node?.sourceUrl || '';
---

<Layout title={seoTitle} seo={project?.seo} description={seoDesc} ogTitle={project?.title} ogImage={seoImage}>
  {project ? (
    <main class="w-full bg-slate-50 min-h-screen pb-16">
      
      <!-- 1. HERO SECTION (Editorial Style) -->
      <header class="bg-white border-b border-slate-200">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-10 pb-12">
          <!-- Breadcrumb -->
          <nav class="text-sm text-slate-500 flex flex-wrap items-center gap-2 mb-8 font-medium">
            <a href="/" class="hover:text-primary transition-colors">Home</a>
            <span class="text-slate-300">/</span>
            <a href="/portfolio" class="hover:text-primary transition-colors">Showcase</a>
            {cat && (
              <>
                <span class="text-slate-300">/</span>
                <a href={`/portfolio?cat=${cat.slug}`} class="hover:text-primary transition-colors">{cat.name}</a>
              </>
            )}
            <span class="text-slate-300">/</span>
            <span class="text-slate-900 truncate max-w-[200px] sm:max-w-md">{project.title}</span>
          </nav>

          <!-- Title Area -->
          <div class="max-w-4xl">
            {cat && (
              <span class="inline-block bg-primary/10 text-primary text-xs font-bold uppercase tracking-widest px-3 py-1.5 rounded-full mb-4">
                {cat.name}
              </span>
            )}
            <h1 class="font-display-lg text-primary mb-6 text-[22px] sm:text-[28px] lg:text-[40px] leading-[1.15] tracking-tight">
              {project.title}
            </h1>
          </div>
        </div>
      </header>

      <!-- Featured Image (Full width on mobile, rounded on desktop) -->
      {mainImage && (
        <div class="max-w-6xl mx-auto px-0 sm:px-6 lg:px-8 -mt-8 relative z-10 mb-12 lg:mb-20">
          <figure class="aspect-video w-full overflow-hidden sm:rounded-2xl shadow-xl shadow-slate-200/50 bg-white border sm:border-slate-200">
            <img src={mainImage} alt={project.title} fetchpriority="high" decoding="async" class="w-full h-full object-cover" />
          </figure>
        </div>
      )}

      <!-- 2. PROJECT DETAILS (Horizontal band) -->
      {detailItems.length > 0 && (
        <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 mb-12 lg:mb-16">
          <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6 md:p-8">
            <h2 class="text-xs font-bold uppercase tracking-widest text-primary mb-6 border-b border-slate-100 pb-4">
              Project Details
            </h2>
            <dl class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-x-8 gap-y-6">
              {detailItems.map((s: any) => (
                <div class="min-w-0">
                  <dt class="text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1">{s.label}</dt>
                  <dd class="text-base font-bold text-slate-900 leading-snug break-words">{s.value}</dd>
                </div>
              ))}
            </dl>
          </div>
        </div>
      )}

      <!-- 3. PROJECT STORY (full-width, only when the editor adds content) -->
      {project.content && project.content.trim() !== '' && (
        <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 mb-4">
          <article class="prose prose-lg prose-slate max-w-none
            prose-headings:font-bold prose-headings:text-slate-900 prose-headings:tracking-tight
            prose-p:text-slate-600 prose-p:leading-relaxed
            prose-a:text-primary prose-a:no-underline hover:prose-a:underline
            prose-img:rounded-xl prose-img:shadow-md
            prose-strong:text-slate-900 prose-li:text-slate-600">
            <Fragment set:html={rewriteHtmlMedia(project.content)} />
          </article>
        </div>
      )}

      <!-- 3. RELATED PROJECTS (Refined Cards) -->
      {related.length > 0 && (
        <section class="mt-20 pt-16 pb-16 border-t border-slate-200 bg-white">
          <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
            <h2 class="font-headline-lg text-headline-lg text-primary mb-8">More from {cat?.name || 'Showcase'}</h2>
            
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
              {related.slice(0, 4).map((p: any) => (
                <a href={`/portfolio/${p.slug}`}
                  class="card-lift group flex flex-col bg-white rounded-xl border border-outline-variant overflow-hidden hover:border-primary/30">
                  <div class="relative aspect-square overflow-hidden bg-surface-container-high">
                    {relImg(p) && (
                      <img alt={p.title} loading="lazy" decoding="async"
                        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
                        src={relImg(p)} />
                    )}
                    {p.portfolioCategories?.nodes?.[0]?.name && (
                      <span class="absolute top-3 right-3 bg-white/90 backdrop-blur-sm px-2.5 py-0.5 rounded-full text-[9px] font-bold uppercase tracking-widest text-primary shadow-sm">
                        {p.portfolioCategories.nodes[0].name}
                      </span>
                    )}
                  </div>
                  <div class="p-3">
                    <h3 class="font-label-bold text-sm text-primary group-hover:text-cta-orange transition-colors line-clamp-1">{p.title}</h3>
                  </div>
                </a>
              ))}
            </div>
          </div>
        </section>
      )}

      <!-- 4. CTA SECTION (Modern, clean gradient) -->
      <section class="mt-20 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="bg-primary rounded-3xl overflow-hidden relative shadow-2xl">
          <div class="relative z-10 px-6 py-16 md:py-20 text-center text-white">
            <h2 class="font-headline-lg text-headline-lg mb-4">Ready to start your project?</h2>
            <p class="text-white/70 text-lg md:text-xl mb-10 max-w-2xl mx-auto">
              Our design team is ready to translate your brand vision into a physical masterpiece. Get a free digital proof today.
            </p>
            <div class="flex flex-col sm:flex-row justify-center items-center gap-4">
              <a href="/contact" class="px-8 py-4 bg-cta-orange text-white rounded font-bold uppercase tracking-wider hover:brightness-110 transition-colors shadow-lg">
                Request Free Design Proof
              </a>
              <a href="/products" class="px-8 py-4 bg-transparent border border-white/30 text-white rounded font-bold uppercase tracking-wider hover:bg-white/10 transition-colors">
                Browse Products
              </a>
            </div>
          </div>
        </div>
      </section>

    </main>
  ) : (
    <!-- 404 STATE -->
    <main class="w-full min-h-[70vh] flex items-center justify-center bg-slate-50">
      <section class="text-center px-4">
        <span class="material-symbols-outlined text-slate-300 text-7xl mb-4 block">image_not_supported</span>
        <h1 class="text-3xl font-bold text-primary mb-2">Project not found</h1>
        <p class="text-slate-500 mb-8">The project "{slug}" doesn't exist or has been removed.</p>
        <a href="/portfolio" class="inline-block px-6 py-3 bg-primary text-white rounded font-semibold hover:bg-primary/90 transition-colors">
          Back to Showcase
        </a>
      </section>
    </main>
  )}
</Layout>