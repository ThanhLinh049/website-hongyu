---
import Layout from '../layouts/Layout.astro';

// Branded 404. Static (prerendered) so it serves instantly with no WP call.
const quickLinks = [
  { label: 'Home', url: '/' },
  { label: 'All Products', url: '/products' },
  { label: 'Showcase', url: '/portfolio' },
  { label: 'Services', url: '/services' },
  { label: 'Blog', url: '/blog' },
  { label: 'Contact', url: '/contact' },
];
---

<Layout title="Page Not Found | Hong Yu Manufacturing" description="The page you are looking for could not be found.">
    <main class="bg-surface">
        <section class="relative bg-primary overflow-hidden">
            <div class="absolute right-0 top-0 h-full w-1/3 bg-white/5 skew-x-[-20deg] translate-x-1/2"></div>
            <div class="max-w-container-max mx-auto px-gutter py-xl md:py-[120px] relative z-10 text-center">
                <p class="font-display-lg text-white/90 text-[64px] sm:text-[88px] lg:text-[120px] leading-none tracking-tight">404</p>
                <h1 class="font-headline-lg text-white mt-md mb-sm text-[22px] sm:text-[30px]">Page Not Found</h1>
                <p class="font-body-lg text-white/70 max-w-xl mx-auto mb-lg">
                    The page you're looking for may have been moved, renamed, or no longer exists.
                </p>
                <div class="flex flex-col sm:flex-row items-center justify-center gap-md">
                    <a href="/" class="inline-flex items-center gap-2 bg-cta-orange text-white px-lg py-3 rounded font-label-bold uppercase tracking-wider hover:brightness-110 transition-all">
                        <span class="material-symbols-outlined text-[18px]">home</span> Back to Home
                    </a>
                    <a href="/contact" class="inline-flex items-center gap-2 border border-white/30 bg-white/5 text-white px-lg py-3 rounded font-label-bold uppercase tracking-wider hover:bg-white/10 transition-all">
                        <span class="material-symbols-outlined text-[18px]">call</span> Contact Us
                    </a>
                </div>
            </div>
        </section>

        <section class="max-w-container-max mx-auto px-gutter py-xl">
            <p class="text-center font-label-bold uppercase tracking-widest text-xs text-on-surface-variant mb-lg">Or jump to a section</p>
            <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3 sm:gap-gutter">
                {quickLinks.map((l) => (
                    <a href={l.url} class="group card-lift bg-white border border-outline-variant hover:border-primary rounded-lg p-md text-center flex items-center justify-center gap-1 font-label-bold text-sm text-on-surface hover:text-primary transition-colors">
                        {l.label}
                        <span class="material-symbols-outlined text-[16px] transition-transform group-hover:translate-x-1">arrow_forward</span>
                    </a>
                ))}
            </div>
        </section>
    </main>
</Layout>
