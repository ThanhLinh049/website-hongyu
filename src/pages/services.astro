---
import Services from '../components/services.astro';
import { wpQuery } from '../lib/api';
import { SEO_FRAGMENT } from '../lib/seo';

let pageData = null;
let seoData = null;

try {
  const data = await wpQuery({
    query: `
      query GetServicesPageData {
        page(id: "services", idType: URI) {
          servicesPage {
            heroBadgeText
            heroTag
            heroTitle
            heroDescription
            heroBg {
              node {
                sourceUrl
              }
            }
            heroCtaPrimaryText
            heroCtaSecondaryText
            capabilitiesTitle
            capabilitiesDescription
            capabilitiesList {
              icon
              title
              description
            }
            workflowTitle
            workflowSubtitle
            workflowSteps {
              stepNumber
              title
              description
            }
            ctaTitle
            ctaDescription
            ctaPrimaryText
            ctaSecondaryText
            ctaNote
          }
          ${SEO_FRAGMENT}
        }
        homeFaq: page(id: "home", idType: URI) {
          homePage {
            faqTitle
            faqSubtitle
            faqList {
              question
              answer
            }
          }
        }
      }
    `
  });

  if (data?.page?.servicesPage) {
    pageData = data.page.servicesPage;
  }
  if (data?.page?.seo) {
    seoData = data.page.seo;
  }
  // Shared FAQ: the Services page shows the HOME page's FAQ (single source of
  // truth — the client edits it on Home), so both pages stay in sync. Override
  // any services-level faq* with the home values.
  const homeFaq = data?.homeFaq?.homePage;
  if (homeFaq) {
    pageData = {
      ...(pageData || {}),
      faqTitle: homeFaq.faqTitle,
      faqSubtitle: homeFaq.faqSubtitle,
      faqList: homeFaq.faqList,
    };
  }
} catch (e) {
  console.warn("Failed to fetch services page data from WordPress. Fallback content will be used.", e);
}
---

<Services pageData={pageData} seo={seoData} />
