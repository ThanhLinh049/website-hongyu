---
// Static: every blog post is prerendered at build (deploy). New/edited posts go
// live only on the next Deploy — never automatically. See getStaticPaths below.
import Layout from '../../layouts/Layout.astro';
import { wpQuery, fetchAllNodes, rewriteHtmlMedia } from '../../lib/api';
import { SEO_FRAGMENT } from '../../lib/seo';
import { buildToc } from '../../lib/toc';

export async function getStaticPaths() {
  const nodes = await fetchAllNodes('posts', 'slug');
  return nodes.filter((n: any) => n?.slug).map((n: any) => ({ params: { slug: n.slug } }));
}

const { slug } = Astro.params;

let post = null;
try {
  const data = await wpQuery({
    query: `
      query GetPostBySlug($slug: ID!) {
        post(id: $slug, idType: SLUG) {
          title
          content
          date
          excerpt
          featuredImage {
            node {
              sourceUrl
            }
          }
          categories {
            nodes {
              name
              slug
            }
          }
          author {
            node {
              name
            }
          }
          ${SEO_FRAGMENT}
        }
      }
    `,
    variables: { slug }
  });

  if (data?.post) {
    post = data.post;
  }
} catch (e) {
  console.warn(`Failed to fetch post: ${slug}`, e);
}

// Fallback demo article — shown when the post can't be loaded from WordPress
// (e.g. no backend connection), so the page always renders its original design
// instead of an empty "not found" state.
const defaultPost = {
  title: 'Custom Badges: A Complete Guide to Materials & Finishes',
  content: `
    <p>When the content management system is unavailable, this sample article keeps the page design intact so you can still preview the layout, typography and components.</p>
    <h2>Choosing the Right Material</h2>
    <p>From die-struck metal to woven and PVC, each material delivers a different look, feel and durability profile for your custom badges and patches.</p>
    <h2>Finishes &amp; Plating</h2>
    <p>Polished, antique, matte and color-fill options let you match any brand identity. Our team helps you select the ideal combination for your project.</p>
    <h3>Backing Options</h3>
    <p>Iron-on, velcro, pin and adhesive backings are available depending on how the final product will be used.</p>
  `,
  date: '2026-01-01T00:00:00',
  excerpt: '',
  featuredImage: null,
  categories: { nodes: [{ name: 'Insights', slug: 'insights' }] },
  author: { node: { name: 'Hong Yu' } },
  seo: null,
};
post = post || defaultPost;

// Auto table of contents: add ids to h2/h3 in the post body and collect them.
const { html: contentHtml, toc } = buildToc(rewriteHtmlMedia(post?.content || ''));

const formatDate = (dateStr: string) => {
  try {
    const d = new Date(dateStr);
    return d.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
  } catch { return ''; }
};
---

<Layout title={post ? `${post.title} | Hong Yu Blog` : `Blog Post | ${slug}`} seo={post?.seo}>
  <main class="max-w-full">
    {post ? (
      <>
        <!-- Post Hero -->
        <section class="relative bg-inverse-surface py-xl overflow-hidden">
          {post.featuredImage?.node?.sourceUrl && (
            <div class="absolute inset-0 pointer-events-none">
              <img alt={post.title} fetchpriority="high" decoding="async" class="w-full h-full object-cover opacity-90" src={post.featuredImage.node.sourceUrl} />
              <div class="absolute inset-0 bg-gradient-to-r from-primary via-primary/80 to-transparent"></div>
            </div>
          )}
          <div class="relative max-w-container-max mx-auto px-gutter">
            <div class="max-w-3xl">
              <div class="flex items-center gap-md mb-md">
                <a href="/blog" class="inline-flex items-center gap-1 text-white/70 hover:text-white transition-colors font-label-bold text-sm uppercase tracking-wider">
                  <span class="material-symbols-outlined text-[18px]">arrow_back</span>
                  Back to Blog
                </a>
              </div>
              {post.categories?.nodes?.[0] && (
                <div class="flex items-center gap-sm mb-sm">
                  <span class="font-label-bold text-label-bold text-cta-orange uppercase tracking-[0.2em] text-[12px]">{post.categories.nodes[0].name}</span>
                </div>
              )}
              <h1 class="font-display-lg text-white mb-md text-[22px] sm:text-[28px] lg:text-[40px] leading-[1.15] tracking-tight">{post.title}</h1>
              <div class="flex items-center gap-lg text-white/60 font-body-sm">
                {post.author?.node?.name && (
                  <div class="flex items-center gap-2">
                    <span class="material-symbols-outlined text-[18px]">person</span>
                    <span>{post.author.node.name}</span>
                  </div>
                )}
                {post.date && (
                  <div class="flex items-center gap-2">
                    <span class="material-symbols-outlined text-[18px]">calendar_today</span>
                    <span>{formatDate(post.date)}</span>
                  </div>
                )}
              </div>
            </div>
          </div>
        </section>

        <!-- Post Content — same container width as the product-detail article
             (max-w-container-max), not the narrower max-w-3xl reading column. -->
        <section class="max-w-container-max mx-auto px-gutter py-xl">
          <div>
            {toc.length >= 2 && (
              <nav aria-label="Table of contents" class="mb-lg rounded-lg border border-outline-variant bg-surface-container-low p-md">
                <p class="font-label-bold text-label-bold uppercase tracking-wider text-on-surface-variant mb-sm flex items-center gap-2">
                  <span class="material-symbols-outlined text-[18px]">list</span>
                  On this page
                </p>
                <ul class="space-y-1">
                  {toc.map((item) => (
                    <li class={item.level === 3 ? "pl-4" : ""}>
                      <a href={`#${item.id}`} class="text-primary hover:underline text-body-sm">{item.text}</a>
                    </li>
                  ))}
                </ul>
              </nav>
            )}
            <article class="prose prose-lg max-w-none
              prose-headings:text-primary prose-headings:font-bold
              prose-p:text-on-surface-variant prose-p:leading-relaxed
              prose-a:text-primary prose-a:underline
              prose-img:rounded-lg prose-img:shadow-md
              prose-blockquote:border-l-4 prose-blockquote:border-primary prose-blockquote:bg-surface-container-low prose-blockquote:p-md
              prose-strong:text-on-surface
              prose-ul:text-on-surface-variant prose-ol:text-on-surface-variant
              prose-headings:scroll-mt-28"
              set:html={contentHtml} />
          </div>
        </section>

        <!-- CTA Bottom -->
        <section class="py-xl bg-surface-container-low border-t border-outline-variant">
          <div class="max-w-container-max mx-auto px-gutter text-center">
            <h2 class="font-headline-lg text-primary mb-md">Ready to start your custom project?</h2>
            <p class="font-body-lg text-on-surface-variant mb-lg max-w-xl mx-auto">Our team is here to help you create the perfect custom badges, patches, and metal products for your brand.</p>
            <div class="flex flex-col sm:flex-row justify-center gap-md">
              <a href="/contact"
                class="inline-block px-lg py-3 bg-primary text-white font-bold uppercase tracking-wider hover:bg-primary/90 shadow-lg transition-all text-center">Request Free Design Proof</a>
              <a href="/blog"
                class="inline-block px-lg py-3 border border-outline-variant text-on-surface font-bold uppercase tracking-wider hover:bg-surface-container-high transition-all text-center">Browse More Articles</a>
            </div>
          </div>
        </section>
      </>
    ) : (
      <section class="max-w-container-max mx-auto px-gutter py-xl text-center">
        <span class="material-symbols-outlined text-outline text-7xl mb-md block">article</span>
        <h1 class="font-display-lg text-primary mb-md">Post Not Found</h1>
        <p class="text-on-surface-variant font-body-lg mb-lg">The blog post "{slug}" could not be loaded from WordPress.</p>
        <a href="/blog" class="inline-block px-lg py-3 bg-primary text-white font-bold uppercase tracking-wider hover:bg-primary/90 transition-all">Return to Blog</a>
      </section>
    )}
  </main>
</Layout>
