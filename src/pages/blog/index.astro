---
import Blog from '../../components/blog.astro';
import { wpQuery } from '../../lib/api';
import { SEO_FRAGMENT } from '../../lib/seo';

let posts = [];
let categories = [];
let pageData = null;
let seoData = null;

try {
  const data = await wpQuery({
    query: `
      query GetAllPosts {
        page(id: "blog", idType: URI) {
          blogPage {
            heroBadge
            heroTitle
            heroSubtitle
            heroImage { node { sourceUrl } }
            newsletterTitle
            newsletterText
            newsletterButton
            featuredPost {
              nodes {
                ... on Post {
                  title
                  slug
                  excerpt
                  date
                  featuredImage { node { sourceUrl } }
                  categories { nodes { name slug } }
                }
              }
            }
          }
          ${SEO_FRAGMENT}
        }
        posts(first: 100, where: { orderby: { field: DATE, order: DESC } }) {
          nodes {
            title
            slug
            excerpt
            date
            featuredImage {
              node {
                sourceUrl
              }
            }
            categories {
              nodes {
                name
                slug
              }
            }
          }
        }
        categories(first: 50, where: { hideEmpty: true }) {
          nodes {
            name
            slug
            count
          }
        }
      }
    `
  });

  if (data?.posts?.nodes) {
    posts = data.posts.nodes;
  }
  if (data?.categories?.nodes) {
    categories = data.categories.nodes;
  }
  if (data?.page?.blogPage) {
    pageData = data.page.blogPage;
  }
  if (data?.page?.seo) {
    seoData = data.page.seo;
  }
} catch (e) {
  console.warn("Failed to fetch blog posts from WordPress. Fallback content will be used.", e);
}
---

<Blog posts={posts} categories={categories} pageData={pageData} seo={seoData} />
