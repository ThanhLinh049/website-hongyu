---
export const prerender = false; // SSR: renders any product slug live from WP
import Layout from '../../../layouts/Layout.astro';
import { wpQuery } from '../../../lib/api';

const { category, slug } = Astro.params;

let product: any = null;
let all: any[] = [];
try {
  const data = await wpQuery({
    query: `
      query GetProduct($slug: ID!) {
        product(id: $slug, idType: SLUG) {
          title
          slug
          content
          productFields { shortDescription }
          featuredImage { node { sourceUrl } }
          productGallery { gallery { nodes { sourceUrl } } }
          productCategories { nodes { name slug } }
          seo { title description openGraph { image { url } } }
        }
        products(first: 200) {
          nodes {
            title slug
            featuredImage { node { sourceUrl } }
            productCategories { nodes { slug } }
          }
        }
      }
    `,
    variables: { slug }
  });
  product = data?.product || null;
  all = data?.products?.nodes || [];
} catch (e) {
  console.warn('Failed to fetch product', slug, e);
}

if (!product) {
  Astro.response.status = 404;
}

const shortDesc = product?.productFields?.shortDescription || '';
const mainImage = product?.featuredImage?.node?.sourceUrl || '';
const galleryUrls: string[] = product
  ? [mainImage, ...((product.productGallery?.gallery?.nodes || []).map((n: any) => n.sourceUrl).filter(Boolean))]
      .filter((v, i, a) => v && a.indexOf(v) === i)
  : [];
// Prefer the category from the URL; fall back to the product's first category.
const cats = product?.productCategories?.nodes || [];
const cat = cats.find((c: any) => c.slug === category) || cats[0];
const catSlug = cat?.slug || category;
const base = `/products/${catSlug}`;
const related = product
  ? (all || []).filter((p: any) => p.slug !== product.slug && (p.productCategories?.nodes || []).some((c: any) => c.slug === catSlug)).slice(0, 4)
  : [];

const seoTitle = product?.seo?.title || (product ? `${product.title} | Products` : 'Product not found');
const seoDesc = product?.seo?.description || shortDesc || '';
const seoImage = product?.seo?.openGraph?.image?.url || mainImage;
const relImg = (p: any) => p?.featuredImage?.node?.sourceUrl || '';
---

<Layout title={seoTitle} description={seoDesc} ogTitle={product?.title} ogImage={seoImage}>
  {product ? (
    <main class="w-full bg-surface">
      <!-- Breadcrumb -->
      <nav class="bg-surface-container-low border-b border-outline-variant">
        <div class="max-w-container-max mx-auto px-gutter py-sm text-[12px] text-on-surface-variant flex flex-wrap items-center gap-xs">
          <a href="/" class="hover:text-primary">Home</a><span>/</span>
          <a href="/products" class="hover:text-primary">Products</a>
          {cat && (<><span>/</span><a href={base} class="hover:text-primary font-bold text-primary">{cat.name}</a></>)}
          <span>/</span><span class="text-on-surface font-medium truncate max-w-[200px]">{product.title}</span>
        </div>
      </nav>

      <!-- Product showcase: gallery + buy-box -->
      <section class="py-xl bg-white">
        <div class="max-w-container-max mx-auto px-gutter grid grid-cols-1 lg:grid-cols-12 gap-md lg:gap-xl items-start">
          <!-- Gallery -->
          <div class="lg:col-span-7">
            <div class="aspect-square bg-surface border border-outline-variant overflow-hidden">
              {mainImage
                ? <img id="detail-main-image" src={mainImage} alt={product.title} class="w-full h-full object-cover" />
                : <div class="w-full h-full flex items-center justify-center text-outline"><span class="material-symbols-outlined text-7xl">image</span></div>}
            </div>
            {galleryUrls.length > 1 && (
              <div class="flex gap-sm mt-sm flex-wrap">
                {galleryUrls.map((url: any, i: number) => (
                  <button type="button" data-thumb={url}
                    class={`detail-thumb w-16 sm:w-20 h-16 sm:h-20 border ${i === 0 ? 'border-primary' : 'border-outline-variant'} overflow-hidden hover:border-primary transition-colors`}>
                    <img src={url} alt={`${product.title} ${i + 1}`} class="w-full h-full object-cover" />
                  </button>
                ))}
              </div>
            )}
          </div>

          <!-- Buy-box (sticky) -->
          <div class="lg:col-span-5">
            <div class="lg:sticky lg:top-[100px]">
              {cat && (<a href={base} class="inline-block border border-primary/30 text-primary text-[11px] font-bold uppercase tracking-widest px-sm py-xs mb-md hover:bg-primary hover:text-white transition-colors">{cat.name}</a>)}
              <h1 class="font-display-lg text-display-lg text-primary leading-tight mb-md">{product.title}</h1>
              {shortDesc && (
                <div class="font-body-md text-on-surface-variant mb-lg whitespace-pre-line leading-relaxed border-t border-outline-variant pt-md">{shortDesc}</div>
              )}

              <a href="/contact" class="block w-full text-center bg-cta-orange text-white px-lg py-4 font-label-bold uppercase tracking-wider hover:brightness-110 transition-all mb-sm">Request Quote</a>
              <div class="flex items-start gap-sm text-[12px] text-on-surface-variant">
                <span class="material-symbols-outlined text-[18px] text-primary">verified</span>
                <span>Fully customizable with your logo &amp; colours. Free design proof in 24h.</span>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Detailed description (editor content) -->
      {product.content && (
        <section class="py-xl bg-surface-container-low border-y border-outline-variant">
          <div class="max-w-3xl mx-auto px-gutter">
            <h2 class="font-headline-lg text-primary mb-lg">Product Details</h2>
            <article class="prose prose-lg max-w-none
              prose-headings:text-primary prose-headings:font-bold
              prose-p:text-on-surface-variant prose-p:leading-relaxed
              prose-a:text-primary prose-img:rounded-lg prose-img:shadow-md
              prose-strong:text-on-surface prose-li:text-on-surface-variant"
              set:html={product.content} />
          </div>
        </section>
      )}

      <!-- Related products -->
      {related.length > 0 && (
        <section class="py-xl bg-white">
          <div class="max-w-container-max mx-auto px-gutter">
            <h2 class="font-headline-lg text-primary mb-lg">Related Products</h2>
            <div class="grid grid-cols-2 md:grid-cols-4 gap-md">
              {related.map((p: any) => (
                <a href={`${base}/${p.slug}`} class="bg-white border border-outline-variant hover:shadow-lg hover:border-primary transition-all group overflow-hidden flex flex-col">
                  <div class="aspect-square bg-surface relative overflow-hidden">
                    {relImg(p) && <img src={relImg(p)} alt={p.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />}
                  </div>
                  <div class="p-md">
                    <h4 class="font-headline-sm text-sm group-hover:text-primary transition-colors">{p.title}</h4>
                  </div>
                </a>
              ))}
            </div>
          </div>
        </section>
      )}

      <!-- CTA -->
      <section class="py-xl bg-primary text-white text-center">
        <div class="max-w-container-max mx-auto px-gutter">
          <h2 class="font-headline-lg mb-sm">Need this customised for your brand?</h2>
          <p class="font-body-lg text-white/70 mb-lg max-w-xl mx-auto">Send us your artwork and our specialists will prepare a free digital proof and B2B quote.</p>
          <a href="/contact" class="inline-block bg-cta-orange text-white px-xl py-md font-label-bold uppercase tracking-widest hover:brightness-110 transition-all">Request Free Quote</a>
        </div>
      </section>
    </main>
  ) : (
    <main class="w-full">
      <section class="max-w-container-max mx-auto px-gutter py-xl text-center">
        <span class="material-symbols-outlined text-outline text-7xl mb-md block">inventory_2</span>
        <h1 class="font-display-lg text-primary mb-md">Product not found</h1>
        <p class="text-on-surface-variant font-body-lg mb-lg">The product "{slug}" doesn't exist or has been removed.</p>
        <a href="/products" class="inline-block px-lg py-3 bg-primary text-white font-bold uppercase tracking-wider hover:bg-primary/90 transition-all">Back to Products</a>
      </section>
    </main>
  )}

  <script>
    const setupGallery = () => {
      const main = document.getElementById('detail-main-image') as HTMLImageElement | null;
      const thumbs = Array.from(document.querySelectorAll('.detail-thumb')) as HTMLElement[];
      if (!main) return;
      thumbs.forEach(t => t.addEventListener('click', () => {
        const url = t.dataset.thumb;
        if (url) main.src = url;
        thumbs.forEach(x => { x.classList.remove('border-primary'); x.classList.add('border-outline-variant'); });
        t.classList.add('border-primary'); t.classList.remove('border-outline-variant');
      }));
    };
    setupGallery();
    document.addEventListener('astro:after-swap', setupGallery);
  </script>
</Layout>
