---
import Home from '../components/home.astro';
import { wpQuery } from '../lib/api';
import { SEO_FRAGMENT } from '../lib/seo';

let pageData = null;
let seoData = null;
let portfolios = [];
let posts = [];
let categories = [];

try {
  const data = await wpQuery({
    query: `
      query GetHomePageData {
        page(id: "home", idType: URI) {
          homePage {
            heroSlides {
              badgeText
              heading
              subheading
              backgroundImage {
                node {
                  sourceUrl
                }
              }
            }
            heroCtaLabel
            heroCtaUrl
            heroTrustBar {
              icon
              label
            }
            introTitle
            introText
            introImage {
              node {
                sourceUrl
              }
            }
            specialtiesTitle
            specialtiesSubtitle
            specialties {
              image {
                node {
                  sourceUrl
                }
              }
              title
              description
              linkLabel
              linkUrl
            }
            advantageTitle
            advantageSubtitle
            advantageBlocks {
              icon
              title
              description
              isHighlight
              stats {
                value
                label
              }
            }
            processTitle
            processSteps {
              icon
              title
              description
            }
            capabilitiesTitle
            capabilitiesDescription
            capabilitiesImage {
              node {
                sourceUrl
              }
            }
            capabilitiesList {
              title
              description
            }
            portfolioSectionTitle
            portfolioSectionSubtitle
            recentCategories {
              nodes {
                name
                slug
              }
            }
            portfolioCtaLabel
            portfolioCtaUrl
            blogSectionTitle
            blogCtaLabel
            blogCtaUrl
            ctaTitle
            ctaText
            ctaBtnLabel
            ctaBtnUrl
            ctaSecondaryLabel
            ctaSecondaryUrl
          }
          ${SEO_FRAGMENT}
        }
        portfolios(first: 8) {
          nodes {
            title
            slug
            featuredImage {
              node {
                sourceUrl
              }
            }
            portfolioCategories { nodes { name slug } }
          }
        }
        posts(first: 3) {
          nodes {
            title
            slug
            excerpt
            date
            featuredImage {
              node {
                sourceUrl
              }
            }
            categories {
              nodes {
                name
              }
            }
          }
        }
        productCategories(first: 50, where: { hideEmpty: false }) {
          nodes {
            name
            slug
            count
            categoryFields { catTagline catHeroImage { node { sourceUrl } } }
            categoryHomeFields { featureOnHome homeOrder }
          }
        }
      }
    `
  });

  if (data?.page?.homePage) {
    pageData = data.page.homePage;
  }
  if (data?.page?.seo) {
    seoData = data.page.seo;
  }
  if (data?.portfolios?.nodes) {
    portfolios = data.portfolios.nodes;
  }
  if (data?.posts?.nodes) {
    posts = data.posts.nodes;
  }
  if (data?.productCategories?.nodes) {
    categories = data.productCategories.nodes;
  }
} catch (e) {
  console.warn("Failed to fetch home page data from WordPress. Fallback static content will be used in components.", e);
}
---

<Home pageData={pageData} portfolios={portfolios} posts={posts} categories={categories} seo={seoData} />
