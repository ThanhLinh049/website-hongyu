# WordPress GraphQL endpoint. Change this to your public WP URL on deploy.
WORDPRESS_API_URL=http://localhost/hongyu/graphql

# Origin used for WordPress images. Optional — by default it follows the host of
# WORDPRESS_API_URL, so changing the line above is usually enough.
#   - Point images at a different host (e.g. a CDN):  PUBLIC_WP_URL=https://cdn.example.com
#   - Serve media from the SAME domain as the frontend (image paths become a
#     fully relative "/wp-content/..."):              PUBLIC_WP_URL=
# PUBLIC_WP_URL=http://localhost/hongyu
