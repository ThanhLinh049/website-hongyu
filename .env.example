# =============================================================================
# WordPress connection
# =============================================================================
# The WPGraphQL endpoint the frontend queries.
#
#   Local dev (Laragon):   http://localhost/hongyu/graphql
#   Production (VPS):       https://cms.your-domain.com/graphql
#
# On Vercel you DON'T edit this file — set WORDPRESS_API_URL in
# Project → Settings → Environment Variables, then Redeploy.
WORDPRESS_API_URL=http://localhost/hongyu/graphql

# -----------------------------------------------------------------------------
# Image origin (optional)
# -----------------------------------------------------------------------------
# Where WordPress media (/wp-content/uploads/...) is served from. By default it
# follows the host of WORDPRESS_API_URL, so for a normal VPS setup you change
# NOTHING here — images load from https://cms.your-domain.com/wp-content/...
#
# Override only for special cases:
#   - Media on a separate CDN:        PUBLIC_WP_URL=https://cdn.your-domain.com
#   - Media on the SAME domain as the
#     frontend (paths become fully
#     relative "/wp-content/..."):     PUBLIC_WP_URL=
# PUBLIC_WP_URL=https://cms.your-domain.com

# -----------------------------------------------------------------------------
# Frontend origin (optional, recommended on deploy)
# -----------------------------------------------------------------------------
# Public URL of THIS frontend. Used to emit absolute canonical / Open Graph URLs
# and the sitemap/robots links. Unset = falls back to the request origin (fine
# for local dev).
# PUBLIC_SITE_URL=https://your-frontend.com

# -----------------------------------------------------------------------------
# Media proxy (optional)
# -----------------------------------------------------------------------------
# Images are served same-origin via /media/* (hides the WP domain, strong cache)
# by default. Set to "0" to fall back to absolute WordPress image URLs.
# PUBLIC_MEDIA_PROXY=1

# =============================================================================
# Resend (contact + newsletter email delivery)
# =============================================================================
# The Contact "Request a Quote" form and the Blog newsletter form POST to our
# serverless routes (/api/contact, /api/newsletter), which send a fully
# brand-designed HTML email via Resend. Chosen over Web3Forms because it allows
# a custom-branded email, a wp-admin-editable recipient, and file attachments.
#
# Setup:
#   1. Create a Resend account → https://resend.com
#   2. API Keys → create one → paste into RESEND_API_KEY below
#   3. (Recommended) Domains → add "hongyu.<tld>" → add the shown DNS records →
#      once "Verified", set RESEND_FROM to e.g. "Hong Yu <no-reply@hongyu.com>"
#   4. On Vercel, set the same vars in Settings → Environment Variables → Redeploy
#
# Until the domain is verified, use the shared test sender below; note Resend's
# test sender can only deliver to your own Resend account email.
RESEND_API_KEY=
RESEND_FROM=Hong Yu <onboarding@resend.dev>

# Fallback recipient for form emails when WordPress has no "Form Recipient Email"
# set (WP admin → Site Settings → Forms) or WP is unreachable.
FORM_RECIPIENT=you@example.com
